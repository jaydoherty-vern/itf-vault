RECREATE Layoutrule one_time_and_recurring_survey_layout__c.survey_required_product_field__c (
   active(true),
   description('Requires Product field when Assignment Type is Product'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields('product__v'),
   expression('assignment_type__v=''product__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Survey Required Product Field'),
   order(500)
);