RECREATE Layoutrule content_acknowledgement_item_layout__c.readonly_fields_received_qty__c (
   active(true),
   description('Layout rule to make the Received Quantity field read only when a Signature Date is present on the Content Acknowledgment record.'),
   displayed_as_readonly_fields('received_quantity__v'),
   displayed_as_required_fields(),
   expression('Not(IsBlank(aoc_signature_date__v))'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Read-Only Fields: Received  Qty'),
   order(200)
);