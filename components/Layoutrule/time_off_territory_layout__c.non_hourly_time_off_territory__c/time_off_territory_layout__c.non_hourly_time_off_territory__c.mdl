RECREATE Layoutrule time_off_territory_layout__c.non_hourly_time_off_territory__c (
   active(true),
   description('Hide Hours and Start Time fields when Time is not Hourly'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('time__v != ''hourly__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('hours_off__v',
      'start_time__v'),
   hide_sections(),
   hide_layout(false),
   label('Non-Hourly Time Off Territory'),
   order(300)
);