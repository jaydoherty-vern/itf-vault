RECREATE Layoutrule lot_catalog_page_layout__c.required_field_sample__c (
   active(true),
   description('Layout rule to make Sample field required on page layout.'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields('sample__v'),
   expression('true'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Required Field: Sample'),
   order(100)
);