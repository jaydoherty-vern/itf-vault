RECREATE Layoutrule user_survey_layout__c.survey_hide_product_field__c (
   active(true),
   description('Hides Product field when Assignment Type is Territory'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('assignment_type__v=''territory__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('product__v'),
   hide_sections(),
   hide_layout(false),
   label('Survey Hide Product Field'),
   order(200)
);