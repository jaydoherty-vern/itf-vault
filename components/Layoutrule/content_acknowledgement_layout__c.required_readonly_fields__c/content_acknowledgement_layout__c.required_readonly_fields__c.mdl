RECREATE Layoutrule content_acknowledgement_layout__c.required_readonly_fields__c (
   active(true),
   description('Layout rule to make Content Acknowledgment Status field required and Signature Date read-only on page layout.'),
   displayed_as_readonly_fields('signature_date__v'),
   displayed_as_required_fields('content_acknowledgement_status__v'),
   expression('true'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Required, Read-Only Fields'),
   order(100)
);