RECREATE Notificationtemplate time_off_territory_review__c (
   label('Time Off Territory Review'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.time_off_territory__v'),
   subject('Time Off Territory request has been submitted for your review'),
   notification('${Object.ownerid__v} submitted ${Object.name__v} Time Off Territory for review.'),
   email_body('A Time Off Territory request has been created in Vault CRM for your review. See details below:<br/> <br/> TOT ID: ${Object.name__v} <br/> Submitter: ${Object.ownerid__v} <br/> Date: ${Object.date__v} <br/> Time: ${Object.time__v} <br/> Reason: ${Object.reason__v}'),
   entity_type('object'),
   notification_category('none__sys')
);