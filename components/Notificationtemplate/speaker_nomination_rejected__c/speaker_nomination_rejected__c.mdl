RECREATE Notificationtemplate speaker_nomination_rejected__c (
   label('Speaker Nomination Rejected'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.em_speaker_nomination__v'),
   subject('Speaker Nomination Rejected'),
   notification('Speaker Nomination (${Object.name__v}) for ${Object.last_name__v},${Object.first_name__v} has been rejected.'),
   email_body('Speaker Nomination (${Object.name__v}) for ${Object.last_name__v},${Object.first_name__v} has been rejected.'),
   entity_type('object'),
   notification_category('tasks__sys')
);