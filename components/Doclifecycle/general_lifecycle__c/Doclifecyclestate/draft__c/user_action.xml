<?xml version="1.0" encoding="UTF-8"?>
<rules>
    <rule>
        <actions>
            <action type="CHECK_USER_ACTION">
                <UserAction actionType="RunWorkflow" workflowKey="review_workflow__c" flowType="object" label="Start Review" publicKey="start_review__c" />
            </action>
        </actions>
    </rule>
    <rule>
        <actions>
            <action type="CHECK_USER_ACTION">
                <UserAction actionType="RunWorkflow" workflowKey="approval_workflow__c" flowType="object" label="Start Approval" publicKey="start_approval__c" />
            </action>
        </actions>
    </rule>
    <rule>
        <actions>
            <action type="CHECK_USER_ACTION">
                <UserAction actionType="StateChange" newState="approved__c" label="Approve" publicKey="approve__c" />
            </action>
        </actions>
    </rule>
</rules>