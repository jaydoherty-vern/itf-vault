<vault:page xmlns:vault="VeevaVault" controller="Objecttype.message_template__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="language__v" />
            <vault:field reference="message_template_text__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Vault Information" name="vault_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="message_template_id__v" />
            <vault:field reference="vault_dns__v" />
            <vault:field reference="vault_external_id__v" />
            <vault:field reference="vault_guid__v" />
            <vault:field reference="vault_last_modified_date__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>