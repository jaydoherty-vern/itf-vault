<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_speaker_qualification__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="qualification__v" required="true" />
            <vault:field reference="speaker__v" required="true" />
            <vault:field reference="qualification_name__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Rate Details" name="rate_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="rate_type__v" />
            <vault:field reference="rate__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>