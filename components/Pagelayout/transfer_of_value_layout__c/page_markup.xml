<vault:page xmlns:vault="VeevaVault" controller="Object.transfer_of_value__c">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account_costs_spend__c" />
            <vault:field reference="type_of_cost__c" required="true" />
            <vault:field reference="amount_of_costs__c" />
            <vault:field reference="comment__c" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="date_of_costs__c" />
            <vault:field reference="type_of_transfer__c" required="true" />
            <vault:field reference="local_currency__sys" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>