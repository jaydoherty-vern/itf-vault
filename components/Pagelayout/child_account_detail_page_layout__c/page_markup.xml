<vault:page xmlns:vault="VeevaVault" controller="Object.child_account__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="parent_account__v" />
            <vault:field reference="parent_name__v" />
            <vault:field reference="primary__v" />
            <vault:field reference="child_account__v" />
            <vault:field reference="child_name__v" />
            <vault:field reference="network_primary__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Data Change Requests" name="data_change_requests__c">
        <vault:relatedObject relationship="data_change_requests__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="created_by__v" width="200px" />
            <vault:field reference="created_date__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="country_mapping__v" width="200px" />
            <vault:field reference="error__v" width="200px" />
            <vault:field reference="resolution_note__v" width="200px" />
            <vault:field reference="result__v" width="200px" />
            <vault:field reference="data_change_request_status__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="veeva_network_id__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>