<vault:page xmlns:vault="VeevaVault" controller="Objecttype.contract__v.sales__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="wholesaler__v" />
            <vault:field reference="default__v" />
            <vault:field reference="template__v" />
            <vault:field reference="local_currency__sys" />
            <vault:field reference="object_type__v" />
            <vault:field reference="contract_status__v" readOnly="true" />
            <vault:field reference="product_bound__v" />
            <vault:field reference="batch__v" />
            <vault:field reference="template_name__v" />
            <vault:field reference="description__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Contract Lines" name="contract_lines__c">
        <vault:relatedObject relationship="contract_lines__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="om_quantity_target__v" width="200px" />
            <vault:field reference="om_quantity_remaining__v" width="200px" />
            <vault:field reference="om_net_amount_target__v" width="200px" />
            <vault:field reference="om_net_amount_remaining__v" width="200px" />
            <vault:field reference="om_list_amount_target__v" width="200px" />
            <vault:field reference="om_list_amount_remaining__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Contract Partners" name="contract_partners__c">
        <vault:relatedObject relationship="contract_partners__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="signature_datetime__v" width="200px" />
            <vault:field reference="contract_partner_status__v" width="200px" />
            <vault:field reference="acknowledgment__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Pricing Rules" name="pricing_rules__c">
        <vault:relatedObject relationship="pricing_rules__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="start_date__v" width="200px" />
            <vault:field reference="end_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>