<vault:page xmlns:vault="VeevaVault" controller="Objecttype.collaboration_space_configuration__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="space_name__v" />
            <vault:field reference="country__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="connection_status__v" readOnly="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Collaboration Space Resource" name="collaboration_space_resource__c">
        <vault:relatedObject relationship="collaboration_space_resource__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="number_of_channels__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="type__v" width="200px" />
            <vault:field reference="integration_status__v" width="200px" />
            <vault:field reference="integration_status_details__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="details1__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="ownerid__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="status__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>