<vault:page xmlns:vault="VeevaVault" controller="Objecttype.cvent_request_form__v.cvent_request_form__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="cvent_instance__v" />
            <vault:field reference="cvent_request_form_name__v" />
            <vault:field reference="cvent_request_form_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Cvent Field Mappings" name="cvent_field_mappings__c">
        <vault:relatedObject relationship="cvent_field_mappings__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="cvent_field__v" width="200px" />
            <vault:field reference="cvent_field_id__v" width="200px" />
            <vault:field reference="salesforce_field_api_name__v" width="200px" />
            <vault:field reference="sync_direction__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>