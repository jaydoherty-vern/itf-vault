<vault:page xmlns:vault="VeevaVault" controller="Objecttype.survey__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:control reference="channels__v" name="channels__c" />
            <vault:field reference="external_id__v" />
            <vault:field reference="target_type__v" />
            <vault:field reference="share_team__v" required="true" />
            <vault:field reference="survey_status__v" readOnly="true" />
            <vault:field reference="lock__v" />
            <vault:field reference="ownerid__v" readOnly="true" />
            <vault:field reference="expired__v" />
            <vault:field reference="language__v" />
            <vault:field reference="region__v" />
            <vault:field reference="segment__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Score" name="score__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="min_score__v" />
            <vault:field reference="max_score__v" />
            <vault:field reference="score_display__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Assignment Rules" name="assignment_rules__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="assignment_type__v" required="true" />
            <vault:field reference="product__v" />
            <vault:control reference="account_types__v" name="account_types__c" />
            <vault:field reference="open__v" />
            <vault:control reference="territories__v" name="territories__c">
                <vault:bind property="singleTerritory" value="false" />
            </vault:control>
            <vault:field reference="autotarget__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Approved Email Specific" name="approved_email_specific__c">
        <vault:detailform type="One-Column">
            <vault:field reference="iframe_landingpage_url__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Questions" name="questions_section__c" reference="questions_section__v">
        <vault:bind property="qbo" value="false" />
    </vault:section>
    <vault:section title="Segments" name="segments_section__c" reference="segments_section__v" />
    <vault:section title="Targets" name="targets_section__c" reference="targets_section__v" />
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>