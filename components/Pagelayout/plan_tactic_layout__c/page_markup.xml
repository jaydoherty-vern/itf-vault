<vault:page xmlns:vault="VeevaVault" controller="Object.plan_tactic__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account_plan__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="product__v" />
            <vault:field reference="plan_tactic_status__v" readOnly="true" />
            <vault:field reference="progress__v" readOnly="true" />
            <vault:field reference="share_with__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="ownerid__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Account Tactics" name="account_tactics__c">
        <vault:relatedObject relationship="account_tactics__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="account_plan__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>