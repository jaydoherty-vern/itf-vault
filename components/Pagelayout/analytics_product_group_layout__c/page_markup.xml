<vault:page xmlns:vault="VeevaVault" controller="Object.analytics_product_group__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="display_name__v" />
            <vault:field reference="parent_product_group__v" />
            <vault:field reference="market__v" />
            <vault:field reference="do_not_display_in_formulary_for_rep__v" />
            <vault:field reference="display_order__v" />
            <vault:field reference="company_product_group__v" />
            <vault:field reference="display_in_reports__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Analytics Product Groups" name="analytics_product_group__c">
        <vault:relatedObject relationship="analytics_product_group__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="display_name__v" width="200px" />
            <vault:field reference="company_product_group__v" width="200px" />
            <vault:field reference="display_in_reports__v" width="200px" />
            <vault:field reference="display_order__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Product Group Maps" name="product_group_map__c">
        <vault:relatedObject relationship="product_group_map__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>