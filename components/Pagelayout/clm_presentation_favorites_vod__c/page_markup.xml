<vault:page xmlns:vault="VeevaVault" controller="Objecttype.content_preference__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="clm_presentation__v" />
            <vault:field reference="external_id__v" readOnly="true" />
            <vault:field reference="object_type__v" />
            <vault:field reference="ownerid__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>