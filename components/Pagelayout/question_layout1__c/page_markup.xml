<vault:page xmlns:vault="VeevaVault" controller="Objecttype.question__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="text__v" />
            <vault:field reference="answer_choice__v" />
            <vault:field reference="active__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Survey Questions" name="survey_questions__c">
        <vault:relatedObject relationship="survey_questions__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>