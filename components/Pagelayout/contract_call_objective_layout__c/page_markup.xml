<vault:page xmlns:vault="VeevaVault" controller="Objecttype.call_objective__v.base__v">
    <vault:section title="Fields" name="fields__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="object_type__v" />
            <vault:field reference="title__v" />
            <vault:field reference="account__v" />
            <vault:field reference="from_date__v" />
            <vault:field reference="to_date__v" />
            <vault:field reference="contract__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="recurring__v" />
            <vault:field reference="parent_objective__v" />
            <vault:field reference="mobile_id__v" />
            <vault:field reference="completed_flag__v" />
            <vault:field reference="call2__v" />
            <vault:field reference="on_by_default__v" />
            <vault:field reference="one_click_completion__v" />
            <vault:field reference="comment__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Contracts" name="contracts__c">
        <vault:relatedObject relationship="contracts__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>