<vault:page xmlns:vault="VeevaVault" controller="Objecttype.call2__v.base__v">
    <vault:section title="Buttons" name="buttons__c">
        <vault:detailform type="One-Column">
            <vault:control reference="save__v" name="save__c" />
            <vault:control reference="savenew__v" name="savenew__c" />
            <vault:control reference="submit__v" name="submit__c" />
            <vault:control reference="delete__v" name="delete__c" />
            <vault:control reference="more_actions__v" name="more_actions__c" />
            <vault:control reference="address_sample_send_status__v" name="address_sample_send_status__c" />
            <vault:field reference="controlling_parent_account__v" />
            <vault:field reference="parent_address__v" />
            <vault:field reference="allowed_products__v" />
            <vault:field reference="itf_call_outcome__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="General Call Section" name="general_call_section__c" reference="general_call_section__v">
        <vault:bind property="rem" value="false" />
        <vault:bind property="nab" value="true" />
        <vault:bind property="nap" value="true" />
    </vault:section>
    <vault:section title="Attendees" name="call_attendees_section__c" reference="call_attendees_section__v">
        <vault:bind property="paa" value="true" />
        <vault:bind property="ao" value="true" />
        <vault:bind property="atf" value="false" />
        <vault:bind property="st" value="false" />
        <vault:bind property="su" value="true" />
        <vault:bind property="ns" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Attendee Specific Fields" name="attendee_specific_fields__c">
        <vault:detailform type="One-Column">
            <vault:field reference="incurred_expense__v" />
            <vault:field reference="expense_attendee_type__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Other Attendees" name="other_attendees__c">
        <vault:detailform type="One-Column">
            <vault:field reference="attendee_list__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Pending Surveys" name="survey_target_section__c" reference="survey_target_section__v" />
    <vault:section title="Account Plan" name="account_plan__c">
        <vault:detailform type="One-Column">
            <vault:field reference="account_plan__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Call Objective" name="call_objective_section__c" reference="call_objective_section__v">
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Last Call Notes" name="last_call_notes__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="pre_call_notes__v" />
            <vault:field reference="call_comments__v" />
            <vault:field reference="next_call_notes__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Detailing Priority" name="call_details_section__c" reference="call_details_section__v">
        <vault:bind property="eed" value="false" />
        <vault:bind property="htp" value="true" />
        <vault:bind property="rd" value="false" />
        <vault:bind property="sd" value="false" />
        <vault:bind property="fieldNames">
            <vault:list>
                <vault:item value="product_priority_1__v" />
                <vault:item value="product_priority_2__v" />
                <vault:item value="product_priority_3__v" />
                <vault:item value="product_priority_4__v" />
                <vault:item value="product_priority_5__v" />
            </vault:list>
        </vault:bind>
    </vault:section>
    <vault:section title="Account Tactics" name="product_discussion_section__c" reference="product_discussion_section__v">
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Medical Discussion" name="medical_discussion_section__c" reference="medical_discussion_section__v">
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Key Messages And Comments" name="key_messages_section__c" reference="key_messages_section__v">
        <vault:bind property="cat" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="CLM Presentation" name="clmdetails_section__c" reference="clmdetails_section__v">
        <vault:bind property="ded" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Surveys" name="clickstream_section__c" reference="clickstream_section__v">
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Sampling" name="sampling__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="sample_send_card__v" />
            <vault:field reference="sample_card_reason__v" />
            <vault:field reference="sample_card__v" />
            <vault:control reference="sample_opt_in__v" name="sample_opt_in__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Samples and Promotional Items" name="samples_section__c" reference="samples_section__v">
        <vault:bind property="gp" value="false" />
        <vault:bind property="mas" value="false" />
        <vault:bind property="masp" value="false" />
        <vault:bind property="nas" value="false" />
        <vault:bind property="nb" value="false" />
        <vault:bind property="nhvp" value="false" />
        <vault:bind property="no" value="false" />
        <vault:bind property="np" value="false" />
        <vault:bind property="npdma" value="false" />
        <vault:bind property="ns" value="false" />
        <vault:bind property="nsl" value="false" />
        <vault:bind property="nslns" value="false" />
        <vault:bind property="pg" value="false" />
        <vault:bind property="ra" value="false" />
        <vault:bind property="so" value="true" />
        <vault:bind property="sbl" value="true" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Call Expenses" name="expenses_section__c" reference="expenses_section__v">
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Follow Up Activities" name="followup_section__c" reference="followup_section__v" />
    <vault:section title="Call Details" name="call2_detail__c">
        <vault:relatedObject relationship="call2_detail__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="type__v" width="200px" />
            <vault:field reference="created_by__v" width="200px" />
            <vault:field reference="created_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Call Discussions" name="call2_discussion__c">
        <vault:relatedObject relationship="call2_discussion__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>