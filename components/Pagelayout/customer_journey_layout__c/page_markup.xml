<vault:page xmlns:vault="VeevaVault" controller="Objecttype.customer_journey__v.customer_journey__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="product__v" />
            <vault:field reference="detail_group__v" />
            <vault:field reference="description__v" />
            <vault:field reference="brand_plan__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="country_user__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Customer Journey Stages" name="customer_journey_stages__c">
        <vault:relatedObject relationship="customer_journey_stages__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="stage__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Customer Journey Accounts" name="customer_journey_accounts__c">
        <vault:relatedObject relationship="customer_journey_accounts__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="current_customer_journey_stage__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>