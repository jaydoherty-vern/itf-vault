<vault:page xmlns:vault="VeevaVault" controller="Objecttype.expense_header__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="expense_header_status__v" />
            <vault:field reference="concur_status__v" readOnly="true" />
            <vault:spacer />
            <vault:field reference="event__v" readOnly="true" />
            <vault:field reference="transaction_date__v" required="true" />
            <vault:field reference="payment_date__v" />
            <vault:field reference="payment_due_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Payment Details" name="payment_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="split_lines__v" required="true" />
            <vault:spacer />
            <vault:field reference="incurred_expense__v" required="true" />
            <vault:field reference="payee__v" required="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Expense Line Summary" name="expense_line_summary__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="committed__v" />
            <vault:field reference="actual__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Expense Lines" name="expense_lines__c">
        <vault:relatedObject relationship="expense_lines__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="expense_type__v" width="200px" />
            <vault:field reference="actual__v" width="200px" />
            <vault:field reference="committed__v" width="200px" />
            <vault:field reference="event_budget__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>