<vault:page xmlns:vault="VeevaVault" controller="Object.territory_budget__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="type__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="active__v" />
            <vault:field reference="last_transaction__v" />
            <vault:field reference="description__v" />
            <vault:field reference="local_currency__sys" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="territory_budget_status__v" />
            <vault:field reference="territory__v" />
            <vault:field reference="product__v" />
            <vault:field reference="start_quantity__v" />
            <vault:field reference="current_quantity__v" />
            <vault:field reference="start_value__v" />
            <vault:field reference="current_value__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Territory Budget Transactions" name="territory_budget_transactions__c">
        <vault:relatedObject relationship="territory_budget_transactions__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="transaction_date__v" width="200px" />
            <vault:field reference="quantity__v" width="200px" />
            <vault:field reference="value__v" width="200px" />
            <vault:field reference="description__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>