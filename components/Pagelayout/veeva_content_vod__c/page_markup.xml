<vault:page xmlns:vault="VeevaVault" controller="Objecttype.veeva_content__v.base__v">
    <vault:section title="Fields" name="fields__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="content_status__v" />
            <vault:field reference="description__v" />
            <vault:field reference="language__v" />
            <vault:field reference="product__v" />
            <vault:field reference="detail_group__v" />
            <vault:field reference="display_name__v" />
            <vault:field reference="allow_source_download__v" />
            <vault:field reference="publish_for_approved_email__v" />
            <vault:field reference="status_details__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Approved Documents" name="approved_document_veeva_content__c">
        <vault:relatedObject relationship="approved_document_veeva_content__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Veeva Distributions" name="veeva_distribution_veeva_content__c">
        <vault:relatedObject relationship="veeva_distribution_veeva_content__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>