<vault:page xmlns:vault="VeevaVault" controller="Objecttype.inventory_monitoring__v.inventory_monitoring__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account__v" />
            <vault:field reference="call2__v" />
            <vault:field reference="assortment__v" />
            <vault:field reference="notes__v" />
            <vault:field reference="inventory_monitoring_date__v" readOnly="true" />
            <vault:field reference="inventory_monitoring_status__v" readOnly="true" />
            <vault:field reference="contract__v" />
            <vault:field reference="object_type__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Photo" name="photo_tag_section__c" reference="photo_tag_section__v" />
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Inventory Monitoring Lines" name="inventory_monitoring_lines__c">
        <vault:relatedObject relationship="inventory_monitoring_lines__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="facings_simple__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="consumer_price__v" width="200px" />
            <vault:field reference="inventory__v" width="200px" />
            <vault:field reference="position__v" width="200px" />
            <vault:field reference="facings_vertical__v" width="200px" />
            <vault:field reference="layer__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>