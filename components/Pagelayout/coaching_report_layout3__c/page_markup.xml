<vault:page xmlns:vault="VeevaVault" controller="Objecttype.survey__v.coaching_report__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:control reference="channels__v" name="channels__c" />
            <vault:field reference="ownerid__v" readOnly="true" />
            <vault:field reference="survey_status__v" readOnly="true" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Advanced Sharing Setup" name="advanced_sharing_setup__c">
        <vault:detailform type="Two-Columns">
            <vault:control reference="territories__v" name="territories__c">
                <vault:bind property="singleTerritory" value="false" />
            </vault:control>
            <vault:field reference="profile_name__v" />
            <vault:field reference="share_team__v" />
            <vault:spacer />
            <vault:field reference="autotarget__v" />
            <vault:field reference="enable_employee_comment__v" />
            <vault:field reference="product__v" />
            <vault:field reference="detail_group__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Questions" name="questions_section__c" reference="questions_section__v">
        <vault:bind property="qbo" value="false" />
    </vault:section>
    <vault:section title="Segments" name="segments_section__c" reference="segments_section__v" />
    <vault:section title="Advanced Sharing" name="advanced_share_team_section__c" reference="advanced_share_team_section__v" />
</vault:page>