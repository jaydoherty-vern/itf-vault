<vault:page xmlns:vault="VeevaVault" controller="Objecttype.chat_message__v.chat_message__v">
    <vault:section title="Sender Information" name="sender_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="sender_type__v" />
            <vault:field reference="first_name__v" />
            <vault:field reference="last_name__v" />
            <vault:field reference="country_code__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Chat Message Information" name="chat_message_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="sent_datetime__v" />
            <vault:field reference="message__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="message_metadata__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Chat Channel Member Information" name="chat_channel_member_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="user_ext_id__v" />
            <vault:field reference="user__v" />
            <vault:field reference="hcp_ext_id__v" />
            <vault:field reference="account__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Forward Information" name="forward_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="forwarded_comment__v" />
            <vault:field reference="original_message_external_id__v" />
            <vault:field reference="original_author_ext_id__v" />
            <vault:field reference="original_author_name__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="channel_ext_id__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information1__c">
        <vault:detailform type="Two-Columns" />
    </vault:section>
</vault:page>