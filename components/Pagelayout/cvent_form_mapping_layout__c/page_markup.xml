<vault:page xmlns:vault="VeevaVault" controller="Objecttype.cvent_form_mapping__v.cvent_form_mapping__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="cvent_instance__v" />
            <vault:field reference="event_configuration__v" />
            <vault:field reference="event_configuration_country__v" />
            <vault:field reference="cvent_request_form__v" />
            <vault:field reference="attendee_sync_status__v" />
            <vault:field reference="speaker_sync_status__v" />
        </vault:detailform>
