<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_material__v.required_attachment__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="event_material_name__v" required="true" />
            <vault:field reference="event__v" readOnly="true" />
            <vault:field reference="object_type__v" />
            <vault:field reference="attachment_requirement__v" required="true" />
            <vault:field reference="required_event_action__v" required="true" />
            <vault:field reference="has_attachment__v" required="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>