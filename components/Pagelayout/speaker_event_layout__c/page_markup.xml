<vault:page xmlns:vault="VeevaVault" controller="Object.speaker_evaluation__c">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account__c" />
            <vault:field reference="date__c" />
            <vault:field reference="subject__c" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="overall_rating__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Evaluation" name="evaluation__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="subject_knowledge__c" />
            <vault:field reference="credibility__c" />
            <vault:field reference="preparedness__c" />
            <vault:field reference="presentation_skills__c" />
            <vault:field reference="professionalism__c" />
            <vault:field reference="responsive_to_audience__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Comments and Final Assessment" name="comments_and_final_assessment__c">
        <vault:detailform type="One-Column">
            <vault:field reference="comments__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>