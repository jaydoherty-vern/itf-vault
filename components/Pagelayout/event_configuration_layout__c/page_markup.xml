<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_configuration__v.event_configuration__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="event_type__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="object_type__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="external_id__v" required="true" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Event Configuration Countries" name="event_configuration_country__c">
        <vault:relatedObject relationship="event_configuration_country__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="country__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Event Layouts" name="em_event_layout__c">
        <vault:relatedObject relationship="em_event_layout__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="country_override__v" width="200px" />
            <vault:field reference="visible_buttons__v" width="200px" />
            <vault:field reference="event_layout__v" width="200px" />
            <vault:field reference="event_status__v" width="200px" />
            <vault:field reference="event_team_role__v" width="200px" />
            <vault:field reference="application_profile__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Event Actions" name="event_configuration__c">
        <vault:relatedObject relationship="event_configuration__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="country_override__v" width="200px" />
            <vault:field reference="button_name__v" width="200px" />
            <vault:field reference="starting_status__v" width="200px" />
            <vault:field reference="ending_status__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Event Rules" name="event_rules__c">
        <vault:relatedObject relationship="event_rules__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="material__v" width="200px" />
            <vault:field reference="material_name__c" width="200px" />
            <vault:field reference="material_type__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>