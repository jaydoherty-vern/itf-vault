<vault:page xmlns:vault="VeevaVault" controller="Objecttype.expense_header__v.split_expense__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="expense_header_status__v" />
            <vault:field reference="transaction_date__v" />
            <vault:field reference="event__v" readOnly="true" />
            <vault:field reference="committed__v" />
            <vault:field reference="actual__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>