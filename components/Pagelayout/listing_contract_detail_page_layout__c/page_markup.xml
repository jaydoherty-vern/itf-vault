<vault:page xmlns:vault="VeevaVault" controller="Objecttype.contract__v.listing__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="expired__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="contract_status__v" />
            <vault:field reference="local_currency__sys" />
            <vault:field reference="description__v" />
            <vault:field reference="default__v" />
            <vault:field reference="inventory_monitoring_type__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Template Information" name="template_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="template__v" />
            <vault:field reference="template_name__v" />
            <vault:field reference="product_bound__v" />
            <vault:field reference="agreement__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Contract Lines" name="contract_lines__c">
        <vault:relatedObject relationship="contract_lines__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Contract Partners" name="contract_partners__c">
        <vault:relatedObject relationship="contract_partners__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="account_identifier__v" width="200px" />
            <vault:field reference="contract_partner_status__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="ownerid__v" />
        </vault:detailform>
    </vault:section>
</vault:page>