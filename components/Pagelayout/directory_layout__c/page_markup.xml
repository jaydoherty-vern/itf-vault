<vault:page xmlns:vault="VeevaVault" controller="Objecttype.directory__v.clm__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="parent_directory__v" />
            <vault:field reference="level__v" />
            <vault:field reference="display_order__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="external_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Directories" name="directories__c">
        <vault:relatedObject relationship="directories__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="level__v" width="200px" />
            <vault:field reference="display_order__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="CLM Presentations" name="clm_presentations__c">
        <vault:relatedObject relationship="clm_presentations__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>