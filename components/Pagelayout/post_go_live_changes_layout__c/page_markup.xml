<vault:page xmlns:vault="VeevaVault" controller="Objecttype.ms_request__c.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="date__c" />
            <vault:field reference="title__c" />
            <vault:field reference="details__c" required="true" />
            <vault:field reference="object_type__v" />
            <vault:field reference="country__c" required="true" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Request Details" name="request_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="functional_area__c" />
            <vault:field reference="criticality__c" required="true" />
            <vault:field reference="assigned_to__c" required="true" />
            <vault:field reference="status__c" required="true" />
            <vault:field reference="related_ms_request__c" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Solution Information" name="solution_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="veeva_proposed_solution__c" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="solution_type__c" />
            <vault:field reference="solution_details__c" />
            <vault:field reference="approved__c" />
            <vault:field reference="approved_by__c" />
            <vault:field reference="release_date__c" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="ownerid__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="MS Request Follow Up" name="ms_request_follow_up__c">
        <vault:relatedObject relationship="ms_request_follow_up__cr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="comments__c" width="200px" />
            <vault:field reference="created_by__v" width="200px" />
            <vault:field reference="created_date__v" width="200px" />
            <vault:field reference="notify__c" width="200px" />
            <vault:field reference="assign_request__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Related MS Requests" name="ms_requests__c">
        <vault:relatedObject relationship="ms_requests__cr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>