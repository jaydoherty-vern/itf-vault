<vault:page xmlns:vault="VeevaVault" controller="Object.metric_configuration__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="display_order__v" required="true" />
            <vault:field reference="applies_to__v" />
            <vault:field reference="vspa_external_id__c" />
            <vault:field reference="active__v" />
            <vault:field reference="metric_type__v" required="true" />
            <vault:field reference="red_yellow__v" />
            <vault:field reference="yellow_green__v" />
            <vault:field reference="product__v" />
            <vault:field reference="available_values__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>