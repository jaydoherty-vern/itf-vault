<vault:page xmlns:vault="VeevaVault" controller="Objecttype.account_plan__v.account_plan__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account__v" required="true" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="type__c" />
            <vault:field reference="account_plan_status__v" />
            <vault:field reference="progress__v" readOnly="true" />
            <vault:field reference="active__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Description" name="description__c">
        <vault:detailform type="One-Column">
            <vault:field reference="description__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="SWOT Analysis" name="swot_analysis__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="strengths__c" />
            <vault:field reference="weaknesses__c" />
            <vault:field reference="opportunities__c" />
            <vault:field reference="threats__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="View Account Plan Dashboard" name="myinsights_account_plan_section__c" reference="myinsights_account_plan_section__v">
        <vault:bind property="maxHeight" value="0" />
    </vault:section>
    <vault:section title="SWOTs" name="swots__c">
        <vault:relatedObject relationship="swots__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="opportunities__v" width="200px" />
            <vault:field reference="strengths__v" width="200px" />
            <vault:field reference="threats__v" width="200px" />
            <vault:field reference="weaknesses__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Goals" name="goals__c">
        <vault:relatedObject relationship="goals__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="details__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Account Team Members" name="account_team_members__c">
        <vault:relatedObject relationship="account_team_members__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="team_member__v" width="200px" />
            <vault:field reference="role__v" width="200px" />
            <vault:field reference="access__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Key Stakeholders" name="key_stakeholders_section__c" reference="key_stakeholders_section__v" />
    <vault:section title="Plan Tactics" name="plan_tactics__c">
        <vault:relatedObject relationship="plan_tactics__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="plan_tactic_status__v" width="200px" />
            <vault:field reference="progress__v" width="200px" />
            <vault:field reference="share_with__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Account Tactics" name="account_tactic__c">
        <vault:relatedObject relationship="account_tactic__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="plan_tactic__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="account_tactic_status__v" width="200px" />
            <vault:field reference="complete__v" width="200px" />
            <vault:field reference="progress__v" width="200px" />
            <vault:field reference="share_with__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Action Items" name="action_item__c">
        <vault:relatedObject relationship="action_item__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="assignee__v" width="200px" />
            <vault:field reference="account_tactic__v" width="200px" />
            <vault:field reference="plan_tactic__v" width="200px" />
            <vault:field reference="share_with__v" width="200px" />
            <vault:field reference="action_item_status__v" width="200px" />
            <vault:field reference="due_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Calls" name="call2__c">
        <vault:relatedObject relationship="call2__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="call2_status__v" width="200px" />
            <vault:field reference="call_type__v" width="200px" />
            <vault:field reference="call_datetime__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Account Plan Notes" name="medical_insights__c">
        <vault:relatedObject relationship="medical_insights__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="medical_insight_status__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>