<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_material__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="material__v" required="true" />
            <vault:field reference="object_type__v" />
            <vault:field reference="name__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Material Details" name="material_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="event_material_name__v" readOnly="true" />
            <vault:spacer />
            <vault:field reference="description__v" readOnly="true" />
            <vault:field reference="current_material_status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>