<vault:page xmlns:vault="VeevaVault" controller="Objecttype.medical_event__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="start_time__v" required="true" />
            <vault:field reference="end_time__v" required="true" />
            <vault:field reference="duration_hrs_qs__c" />
            <vault:field reference="location__v" />
            <vault:field reference="product_qs__c" />
            <vault:field reference="account__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="event_type__v" />
            <vault:field reference="status_qs__c" />
            <vault:field reference="active__v" />
            <vault:field reference="of_invites_qs__c" />
            <vault:field reference="of_participants_qs__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Description" name="description__c">
        <vault:detailform type="One-Column">
            <vault:field reference="description__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Budget" name="budget__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="planned_costs_qs__c" />
            <vault:field reference="local_currency__sys" />
            <vault:field reference="actual_costs_qs__c" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Event Attendees" name="event_attendee__c">
        <vault:relatedObject relationship="event_attendee__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="attendee_name__v" width="200px" />
            <vault:field reference="speaker__c" width="200px" />
            <vault:field reference="event_attendee_status__v" width="200px" />
            <vault:field reference="signature_datetime__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Event Expenses" name="event_expenses__c">
        <vault:relatedObject relationship="event_expenses__cr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="date__c" width="200px" />
            <vault:field reference="expense_type__c" width="200px" />
            <vault:field reference="amount__c" width="200px" />
            <vault:field reference="description__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Calls" name="call2__c">
        <vault:relatedObject relationship="call2__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="call_datetime__v" width="200px" />
            <vault:field reference="call_type__v" width="200px" />
            <vault:field reference="call2_status__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="person__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>