<vault:page xmlns:vault="VeevaVault" controller="Objecttype.unsubscribe__v.approved_email_unsubscribe__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="unsubscribe_html_file__v" />
            <vault:field reference="unsubscribe_confirm_html_file__v" />
            <vault:field reference="unsubscribe_identifier__v" required="true" />
            <vault:field reference="unsubscribe_modify_confirm_html_file__v" />
            <vault:field reference="unsubscribe_cancel_html_file__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Unsubscribe Products" name="unsubscribe_products__c">
        <vault:relatedObject relationship="unsubscribe_products__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="detail_group__v" width="200px" />
            <vault:field reference="product_display__v" width="200px" />
            <vault:field reference="detail_group_display__v" width="200px" />
            <vault:field reference="display_order__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>