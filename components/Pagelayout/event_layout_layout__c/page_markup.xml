<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_layout__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="visible_buttons__v" />
            <vault:field reference="ownerid__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="country_override__v" />
            <vault:field reference="event_configuration__v" required="true" />
            <vault:field reference="event_status__v" required="true" />
            <vault:field reference="event_layout__v" required="true" />
            <vault:field reference="expense_estimate_layout__v" />
            <vault:field reference="expense_header_layout__v" />
            <vault:field reference="expense_line_layout__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="event_team_role__v" />
            <vault:field reference="application_profile__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="status__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Help Text" name="help_text__c">
        <vault:detailform type="One-Column">
            <vault:field reference="help_text__v" />
        </vault:detailform>
    </vault:section>
</vault:page>