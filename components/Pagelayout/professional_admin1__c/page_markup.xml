        </vault:relatedObject>
    </vault:section>
    <vault:section title="Member Of" name="child_account__c">
        <vault:relatedObject relationship="child_account__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="parent_account__v" width="200px" />
            <vault:field reference="network_primary__v" width="200px" />
            <vault:field reference="role_nwk__c" width="200px" />
            <vault:field reference="role_opd_nwk__c" width="200px" />
            <vault:field reference="status_qs__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Align Account Territories" name="account_territories__c">
        <vault:relatedObject relationship="aln_account_territories__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="territory__v" width="200px" />
            <vault:field reference="start_date__v" width="200px" />
            <vault:field reference="end_date__v" width="200px" />
            <vault:field reference="source__v" width="200px" />
            <vault:field reference="align_rule_name__v" width="200px" />
            <vault:field reference="country__v" width="200px" />
            <vault:field reference="send_to_crm__v" width="200px" />
            <vault:field reference="exclusive_assignment__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Account Territories" name="account_territories1__c">
        <vault:relatedObject relationship="account_territories__vr" preventRecordCreate="false" modalCreateRecord="false" displayAsSimple="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="territory__v" width="200px" />
            <vault:field reference="rule__v" width="200px" />
            <vault:field reference="manual__v" width="200px" />
            <vault:field reference="external_id__v" width="200px" />
            <vault:field reference="territory__vr.name__v" width="200px" />
            <vault:field reference="territory__vr.parent_territory__v" width="200px" />
            <vault:field reference="territory__vr.description__v" width="200px" />
            <vault:field reference="territory__vr.country__v" width="200px" />
            <vault:field reference="territory__vr.api_name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Account Exclusion" name="account_exclusion__c">
        <vault:relatedObject relationship="aln_account_account_exclusions__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="field_force__v" width="200px" />
            <vault:field reference="territory__v" width="200px" />
            <vault:field reference="start_date__v" width="200px" />
            <vault:field reference="end_date__v" width="200px" />
            <vault:field reference="exclusion_type__v" width="200px" />
            <vault:field reference="exclusion_reason__v" width="200px" />
            <vault:field reference="assignment_type__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
