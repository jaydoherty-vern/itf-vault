<vault:page xmlns:vault="VeevaVault" controller="Objecttype.account__v.professional__v">
    <vault:section title="Account Information" name="account_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="first_name_cda__v" />
            <vault:field reference="last_name_cda__v" />
            <vault:field reference="name__v" />
            <vault:field reference="primary_parent__v" />
            <vault:field reference="title_nwk__c" />
            <vault:field reference="market_access_nwk__c" />
            <vault:field reference="grade_nwk__c" />
            <vault:field reference="country_code__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="hcp_type_nwk__c" />
            <vault:field reference="hcp_status_nwk__c" />
            <vault:field reference="specialty_1_nwk__c" />
            <vault:field reference="specialty_2_nwk__c" />
            <vault:field reference="specialty_3_nwk__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Key Indicators" name="key_indicators__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="target__c" />
            <vault:field reference="target_level__c" />
            <vault:field reference="kol_cda__v" />
            <vault:field reference="kol_type__c" />
            <vault:field reference="investigator_cda__v" />
            <vault:field reference="speaker__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="View User Territory" name="view_user_territory_section__c" reference="view_user_territory_section__v" />
    <vault:section title="IDs" name="ids__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="matchid__v" readOnly="true" />
            <vault:field reference="external_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Members" name="parent_account__c">
        <vault:relatedObject relationship="parent_account__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Product Metrics" name="product_metrics__c">
        <vault:relatedObject relationship="product_metrics__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="products__v" width="200px" />
            <vault:field reference="awareness__c" width="200px" />
            <vault:field reference="adoption_level__c" width="200px" />
            <vault:field reference="segment__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Addresses" name="address__c">
        <vault:relatedObject relationship="address__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="street_address_2_cda__v" width="200px" />
            <vault:field reference="phone_cda__v" width="200px" />
            <vault:field reference="city_cda__v" width="200px" />
            <vault:field reference="postal_code_cda__v" width="200px" />
            <vault:field reference="map__v" width="200px" />
