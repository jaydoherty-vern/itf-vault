<vault:page xmlns:vault="VeevaVault" controller="Objecttype.call_objective__v.suggestion__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="title__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="object_type__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="account__v" />
            <vault:field reference="product__v" />
            <vault:field reference="information__v" />
            <vault:field reference="prerequisite__v" />
            <vault:field reference="delivery_method__v" />
            <vault:field reference="account_plan__v" />
            <vault:field reference="account_tactic__v" />
            <vault:field reference="comment__v" />
            <vault:field reference="from_date__v" />
            <vault:field reference="to_date__v" />
            <vault:field reference="recurring__v" />
            <vault:field reference="on_by_default__v" />
            <vault:field reference="non_executable__v" />
            <vault:field reference="one_click_completion__v" />
            <vault:field reference="suggestion__v" />
            <vault:field reference="suggestion_reason__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Execution Details" name="execution_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="date__v" />
            <vault:field reference="call2__v" />
            <vault:field reference="completed_flag__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>