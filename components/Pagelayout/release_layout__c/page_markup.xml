<vault:page xmlns:vault="VeevaVault" controller="Object.release__c">
    <vault:section title="Information" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="itf_release_start_date__c" />
            <vault:field reference="itf_uat_start_date__c" />
            <vault:field reference="itf_uat_close_date__c" />
            <vault:field reference="itf_release_status__c" />
            <vault:field reference="itf_release_go_live_date__c" />
            <vault:field reference="owner__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Requirements" name="requirements__c">
        <vault:relatedObject relationship="requirements__cr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="requirement_title__c" width="200px" />
            <vault:field reference="requirement_description__c" width="200px" />
            <vault:field reference="impacted_business__c" width="200px" />
            <vault:field reference="itf_scoping__c" width="200px" />
            <vault:field reference="urgency_of_request__c" width="200px" />
            <vault:field reference="status_pmo__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>