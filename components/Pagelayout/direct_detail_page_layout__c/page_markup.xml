<vault:page xmlns:vault="VeevaVault" controller="Objecttype.order__v.direct__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account__v" />
            <vault:field reference="account_group__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="order_date__v" />
            <vault:field reference="delivery_date__v" />
            <vault:field reference="order_status__v" />
            <vault:field reference="order_campaign__v" />
            <vault:field reference="call2__v" />
            <vault:field reference="ownerid__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Notes and Warnings" name="notes_and_warnings__c">
        <vault:detailform type="One-Column">
            <vault:field reference="notes__v" />
            <vault:field reference="warning__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Logistics" name="logistics__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="payer__v" />
            <vault:field reference="payment__v" />
            <vault:field reference="billing_address__v" />
            <vault:field reference="billing_address_line_1__v" />
            <vault:field reference="billing_postal_code__v" />
            <vault:field reference="billing_city__v" />
            <vault:field reference="delivery_location__v" />
            <vault:field reference="ship_to_address__v" />
            <vault:field reference="ship_address_line_1__v" />
            <vault:field reference="ship_postal_code__v" />
            <vault:field reference="ship_city__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Order Rebates" name="order_rebates__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="order_discount__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Order Totals" name="order_totals__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="order_total_quantity__v" />
            <vault:field reference="order_list_amount__v" />
            <vault:field reference="order_net_amount__v" />
            <vault:field reference="order_total_discount__v" />
            <vault:field reference="order_free_goods__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Order Lines" name="order_lines__c">
        <vault:relatedObject relationship="order_lines__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="quantity__v" width="200px" />
            <vault:field reference="list_price_rule__v" width="200px" />
            <vault:field reference="total_discount__v" width="200px" />
            <vault:field reference="list_amount__v" width="200px" />
            <vault:field reference="net_amount__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="legacy_crm_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>