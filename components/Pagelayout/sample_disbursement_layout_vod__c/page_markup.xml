<vault:page xmlns:vault="VeevaVault" controller="Objecttype.sample_transaction__v.disbursement__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="call_name__v" required="true" />
            <vault:field reference="disclaimer__v" required="true" />
            <vault:field reference="signature_date__v" />
            <vault:field reference="sample_card__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="group_identifier__v" />
            <vault:field reference="distributor__v" />
            <vault:field reference="type__v" readOnly="true" />
            <vault:field reference="submitted_date__v" readOnly="true" />
            <vault:field reference="sample_transaction_status__v" readOnly="true" />
            <vault:field reference="disbursed_to__v" required="true" />
            <vault:field reference="comments__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Sample Information" name="sample_information__c">
        <vault:detailform type="Two-Columns">
            <vault:control reference="st_sample_field_control__v" name="st_sample_field_control__c" />
            <vault:control reference="st_lot_field_control__v" name="st_lot_field_control__c" />
            <vault:control reference="st_quantity_field_control__v" name="st_quantity_field_control__c" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="status__v" />
            <vault:field reference="lot__v" />
        </vault:detailform>
    </vault:section>
</vault:page>