<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_rule__v.stage_settings__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="event_configuration__v" required="true" />
            <vault:field reference="country_override__v" />
            <vault:field reference="object_type__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="external_id__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="event_rule__v" name="event_stages__c">
        <vault:relatedObject relationship="event_stages__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="stage__v" width="200px" />
            <vault:field reference="statuses__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>