<vault:page xmlns:vault="VeevaVault" controller="Objecttype.planogram__v.planogram__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="height__v" />
            <vault:field reference="width__v" />
            <vault:field reference="modified_by__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Planogram Lines" name="planogram_lines__c">
        <vault:relatedObject relationship="planogram_lines__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="width__v" width="200px" />
            <vault:field reference="height__v" width="200px" />
            <vault:field reference="position_from_base__v" width="200px" />
            <vault:field reference="position_from_left__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Account Partners" name="account_partners__c">
        <vault:relatedObject relationship="account_partners__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="inventory_monitoring_type__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>