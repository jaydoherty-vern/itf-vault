<vault:page xmlns:vault="VeevaVault" controller="Objecttype.sample_transaction__v.transfer__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="transferred_from__v" required="true" />
            <vault:field reference="transferred_date__v" required="true" />
            <vault:field reference="comments__v" />
            <vault:field reference="group_identifier__v" />
            <vault:spacer />
            <vault:field reference="type__v" readOnly="true" />
            <vault:field reference="submitted_date__v" readOnly="true" />
            <vault:field reference="sample_transaction_status__v" readOnly="true" />
            <vault:field reference="receipt_comments__v" readOnly="true" />
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Transfer To Information" name="transfer_to_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="transfer_to__v" required="true" />
            <vault:field reference="address_line_1__v" required="true" />
            <vault:field reference="address_line_2__v" />
            <vault:field reference="city__v" required="true" />
            <vault:control reference="st_state_province_field_control__v" name="st_state_province_field_control__c" />
            <vault:field reference="zip__v" required="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Sample Information" name="sample_information__c">
        <vault:detailform type="Two-Columns">
            <vault:control reference="st_sample_field_control__v" name="st_sample_field_control__c" />
            <vault:control reference="st_lot_field_control__v" name="st_lot_field_control__c" />
            <vault:control reference="st_u_m_field_control__v" name="st_u_m_field_control__c" />
            <vault:control reference="st_quantity_field_control__v" name="st_quantity_field_control__c" />
            <vault:field reference="confirmed_quantity__v" readOnly="true" />
            <vault:field reference="discrepancy__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="status__v" />
            <vault:field reference="lot__v" />
        </vault:detailform>
    </vault:section>
</vault:page>