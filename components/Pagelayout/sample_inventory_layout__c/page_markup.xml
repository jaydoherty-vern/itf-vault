<vault:page xmlns:vault="VeevaVault" controller="Objecttype.sample_inventory__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="inventory_for__v" required="true" />
            <vault:field reference="name__v" />
            <vault:field reference="inventory_date_time__v" required="true" />
            <vault:field reference="inventory_from_date__v" readOnly="true" />
            <vault:field reference="sample_inventory_status__v" readOnly="true" />
            <vault:field reference="created_by__v" />
            <vault:field reference="inventory_type__v" required="true" />
            <vault:field reference="audit__v" />
            <vault:field reference="previous_inventory_date_time__v" />
            <vault:field reference="submitted_date__v" readOnly="true" />
            <vault:field reference="modified_by__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Sample Inventory Items" name="sample_inventory__c">
        <vault:relatedObject relationship="sample_inventory__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>