<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_session__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="event__v" readOnly="true" />
            <vault:field reference="location__v" readOnly="true" />
            <vault:field reference="ownerid__v" readOnly="true" />
            <vault:field reference="start_time__v" readOnly="true" />
            <vault:field reference="end_time__v" readOnly="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Event Session Attendees" name="event_session__c">
        <vault:relatedObject relationship="event_session__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="attendee_name__v" width="200px" />
            <vault:field reference="speaker__v" width="200px" />
            <vault:field reference="team_member__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>