<vault:page xmlns:vault="VeevaVault" controller="Object.message__v">
    <vault:section title="Veeva Systems Information - Do Not Chang" name="veeva_systems_information_do_not_chan__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="description__v" />
            <vault:field reference="type__v" />
            <vault:field reference="category__v" />
            <vault:field reference="external_id__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Customer Editable Information" name="customer_editable_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="active__v" />
            <vault:field reference="language__v" required="true" />
            <vault:field reference="text__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>