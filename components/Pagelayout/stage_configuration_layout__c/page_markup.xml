<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_stage_configuration__v.stage_configuration__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="event_rule__v" required="true" />
            <vault:field reference="stage__v" />
            <vault:field reference="ownerid__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Status" name="status__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="statuses__v" required="true" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>