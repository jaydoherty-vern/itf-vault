<vault:page xmlns:vault="VeevaVault" controller="Objecttype.content_acknowledgement__v.call__v">
    <vault:section title="Requested By" name="requested_by__c">
        <vault:detailform type="One-Column">
            <vault:field reference="account__v" />
            <vault:field reference="ship_license__v" />
            <vault:field reference="lifecycle__v" />
            <vault:field reference="state__v" />
            <vault:field reference="state_stage_id__sys" />
            <vault:field reference="stage__sys" />
            <vault:field reference="ship_zip_4__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Received By" name="received_by__c">
        <vault:detailform type="One-Column">
            <vault:field reference="received_by__v" />
            <vault:field reference="received_title__v" />
            <vault:field reference="signature__v" />
            <vault:field reference="signature_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="order_id__v" />
            <vault:field reference="ship_date__v" />
            <vault:field reference="delivery_date__v" />
            <vault:field reference="ship_location__v" />
            <vault:field reference="ship_address__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Samples Ordered" name="content_acknowledgement_items__c">
        <vault:relatedObject relationship="content_acknowledgement_items__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="lot__v" width="200px" />
            <vault:field reference="ship_quantity__v" width="200px" />
            <vault:field reference="received_quantity__v" width="200px" />
            <vault:field reference="u_m__v" width="200px" />
            <vault:field reference="manufacturer__v" width="200px" />
            <vault:field reference="distributor__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>