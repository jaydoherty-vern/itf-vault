<vault:page xmlns:vault="VeevaVault" controller="Objecttype.pricing_rule__v.product_group_level_rule__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="product__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="pricing_group__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Rule Hierarchy" name="details2__c">
        <vault:detailform type="One-Column">
            <vault:field reference="order_campaign__v" />
            <vault:field reference="contract__v" />
            <vault:field reference="account__v" />
            <vault:field reference="price_book__v" />
            <vault:field reference="account_group__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Rule Definition" name="details1__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="comparison_type__v" />
            <vault:field reference="quantity_max__v" />
            <vault:field reference="quantity_min__v" />
            <vault:field reference="discount_override__v" />
            <vault:field reference="discount_override_max__v" />
            <vault:field reference="rule_description__v" />
            <vault:field reference="suggestion_threshold__v" />
            <vault:field reference="suggestion_text__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Cross Product Rebates" name="details3__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="cross_product_rule__v" />
            <vault:field reference="comparison_product__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Chain Rule Operators" name="details5__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="chain_rule__v" />
            <vault:field reference="chain_rule_operator__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Pricing Subrules" name="pricing_subrules__c">
        <vault:relatedObject relationship="pricing_subrules__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="comparison_type__v" width="200px" />
            <vault:field reference="min_quantity__v" width="200px" />
            <vault:field reference="max_quantity__v" width="200px" />
            <vault:field reference="inventory_monitoring_field_value__v" width="200px" />
            <vault:field reference="inventory_monitoring_line_field__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="details4__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="status__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="legacy_crm_id__v" />
        </vault:detailform>
    </vault:section>
</vault:page>