<vault:page xmlns:vault="VeevaVault" controller="Object.child_account__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="parent_account__v" required="true" />
            <vault:field reference="copy_address__v" readOnly="true" />
            <vault:field reference="status_nwk__c" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="child_account__v" />
            <vault:field reference="itf_hcp_specialty__c" />
            <vault:field reference="role_nwk__c" readOnly="true" />
            <vault:field reference="hierarchy_type__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Survey Targets" name="survey_targets__c">
        <vault:relatedObject relationship="my_surveys__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="created_by__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Child Account Territory" name="childaccount_tsf_section__c" reference="childaccount_tsf_section__v" />
</vault:page>