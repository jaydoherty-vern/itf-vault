<vault:page xmlns:vault="VeevaVault" controller="Objecttype.call2__v.base__v">
    <vault:section title="Buttons" name="buttons__c">
        <vault:detailform type="One-Column">
            <vault:control reference="save__v" name="save__c" label="Save" />
            <vault:control reference="savenew__v" name="savenew__c" label="Save and New" />
            <vault:control reference="more_actions__v" name="more_actions__c" label="More Actions" />
            <vault:control reference="submit__v" name="submit__c" label="Submit" />
            <vault:field reference="itf_call_outcome__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Professional Information" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="account__v" required="true" />
            <vault:field reference="address__v" />
            <vault:control reference="business_account__v" name="business_account__c" label="Location" />
            <vault:spacer />
            <vault:field reference="call_datetime__v" />
            <vault:field reference="call2_status__v" readOnly="true" />
            <vault:field reference="call_channel__v" />
            <vault:field reference="itf_conference__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attendees" name="call_attendees_section__c" reference="call_attendees_section__v">
        <vault:bind property="paa" value="true" />
        <vault:bind property="ao" value="true" />
        <vault:bind property="atf" value="false" />
        <vault:bind property="st" value="false" />
        <vault:bind property="su" value="true" />
        <vault:bind property="ns" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Products Discussed" name="call_details_section__c" reference="call_details_section__v">
        <vault:bind property="rd" value="false" />
        <vault:bind property="eed" value="false" />
        <vault:bind property="htp" value="false" />
        <vault:bind property="sd" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Discussion Topics" name="key_messages_section__c" reference="key_messages_section__v">
        <vault:bind property="cat" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Discussion Topics (Free Text)" name="discussion_topics_free_text__c">
        <vault:detailform type="One-Column">
            <vault:field reference="discussion_topics_free_text__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="CLM Details" name="clmdetails_section__c" reference="clmdetails_section__v">
        <vault:bind property="ded" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="KITs/KIQs" name="survey_target_section__c" reference="survey_target_section__v" />
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
            <vault:field reference="call_type__v" />
            <vault:field reference="territory__v" />
            <vault:field reference="call_channel_formula__v" />
        </vault:detailform>
    </vault:section>
</vault:page>