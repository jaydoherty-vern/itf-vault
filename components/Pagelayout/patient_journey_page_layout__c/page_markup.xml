<vault:page xmlns:vault="VeevaVault" controller="Objecttype.patient_journey__v.patient_journey__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="description__v" />
            <vault:field reference="product__v" />
            <vault:field reference="account__v" />
            <vault:field reference="account_plan__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="patient_journey_status__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="country__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Patient Journey Steps" name="patient_journey_step__c">
        <vault:relatedObject relationship="patient_journey_step__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="description__v" width="200px" />
            <vault:field reference="patient_journey_step_phase__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Patient Journey Step Phases" name="patient_journey_step_phase__c">
        <vault:relatedObject relationship="patient_journey_step_phase__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="description__v" width="200px" />
            <vault:field reference="order__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>