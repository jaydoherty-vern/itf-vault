            <vault:field reference="name__v" />
            <vault:field reference="activity__v" />
            <vault:field reference="client_name__v" />
            <vault:field reference="client_device__v" />
            <vault:field reference="ip_address__v" />
            <vault:field reference="sent_message__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="activity_datetime__v" />
