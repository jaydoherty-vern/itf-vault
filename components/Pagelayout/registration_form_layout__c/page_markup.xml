<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_catalog__v.registration_form__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="em_catalog_name__v" required="true" />
            <vault:field reference="product__v" />
            <vault:field reference="event_format__v" />
            <vault:field reference="location_type__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="em_catalog_status__v" required="true" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Form Details" name="form_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="registration_fields__v" required="true" />
            <vault:field reference="event_fields__v" />
            <vault:field reference="disclaimer_text__v" />
            <vault:spacer />
            <vault:field reference="registration_type__v" />
            <vault:field reference="approval_required__v" />
            <vault:field reference="confirmation_email_template__v" />
            <vault:field reference="rejection_email_template__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Event Rules (Registration)" name="event_rules_registration__c">
        <vault:relatedObject relationship="event_rules_registration__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="event_configuration__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>