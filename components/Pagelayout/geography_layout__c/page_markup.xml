<vault:page xmlns:vault="VeevaVault" controller="Object.aln_geography__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="geography_type__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="administrative_area__v" />
            <vault:field reference="country__v" />
            <vault:field reference="map_shape__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="id" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Territories with Geography Assigned" name="territories__c">
        <vault:relatedObject relationship="aln_geography_territories__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="territory__v" width="200px" />
            <vault:field reference="start_date__v" width="200px" />
            <vault:field reference="end_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Footprints containing Geography" name="footprints__c">
        <vault:relatedObject relationship="aln_footprint_geographies__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="footprint__v" width="200px" />
            <vault:field reference="start_date__v" width="200px" />
            <vault:field reference="end_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>