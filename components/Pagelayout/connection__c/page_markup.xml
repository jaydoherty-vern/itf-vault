<vault:page xmlns:vault="VeevaVault" controller="Objecttype.connection__v.connection__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="connection_url__v" required="true" />
            <vault:field reference="type__v" required="true" />
            <vault:field reference="last_sync_date__v" />
            <vault:field reference="last_sync_status__v" />
            <vault:field reference="next_sync_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>