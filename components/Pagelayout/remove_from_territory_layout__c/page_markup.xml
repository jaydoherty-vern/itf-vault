<vault:page xmlns:vault="VeevaVault" controller="Objecttype.data_change_request__v.remove_from_territory__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="data_change_request_status__v" readOnly="true" />
            <vault:field reference="external_status__v" readOnly="true" />
            <vault:field reference="ownerid__v" readOnly="true" />
            <vault:field reference="sent_datetime__v" readOnly="true" />
            <vault:field reference="object_type__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Unalignment Information" name="unalignment_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="account__v" readOnly="true" />
            <vault:field reference="territory_label__v" readOnly="true" />
            <vault:field reference="challenge_reasons__v" required="true" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Resolution" name="resolution__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="result__v" readOnly="true" />
            <vault:field reference="resolution_note__v" readOnly="true" />
            <vault:field reference="response_datetime__v" readOnly="true" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>