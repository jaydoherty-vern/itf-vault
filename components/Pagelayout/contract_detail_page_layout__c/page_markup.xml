        </vault:relatedObject>
    </vault:section>
    <vault:section title="Account Partners" name="account_partners__c">
        <vault:relatedObject relationship="account_partners__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
            <vault:field reference="status__v" width="200px" />
