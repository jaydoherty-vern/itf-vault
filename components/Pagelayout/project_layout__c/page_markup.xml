    </vault:section>
    <vault:section title="Model Align Settings in Project" name="model_align_settings__c">
        <vault:relatedObject relationship="aln_align_settings_model__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="status__v" width="200px" />
            <vault:field reference="modified_date__v" width="200px" />
            <vault:field reference="field_force_model__v" width="200px" />
            <vault:field reference="production_record__v" width="200px" />
            <vault:field reference="description__v" width="200px" />
            <vault:field reference="type__v" width="200px" />
            <vault:field reference="account_exclusivity__v" width="200px" />
            <vault:field reference="account_exclusivity_exceptions__v" width="200px" />
