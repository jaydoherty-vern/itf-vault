    <vault:section title="Model Account Exclusions in Project" name="model_account_exclusions__c">
        <vault:relatedObject relationship="aln_account_exclusion_model__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
