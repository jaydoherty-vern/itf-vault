            <vault:field reference="description__v" width="200px" />
            <vault:field reference="parent_territory_model__v" width="200px" />
            <vault:field reference="field_force_model__v" width="200px" />
            <vault:field reference="hierarchy_level__v" width="200px" />
            <vault:field reference="start_date__v" width="200px" />
            <vault:field reference="end_date__v" width="200px" />
            <vault:field reference="state__v" width="200px" />
            <vault:field reference="send_to_crm__v" width="200px" />
            <vault:field reference="production_territory__v" width="200px" />
