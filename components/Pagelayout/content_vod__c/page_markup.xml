<vault:page xmlns:vault="VeevaVault" controller="Objecttype.sent_message__v.content__v">
    <vault:section title="Content" name="content__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account__v" />
            <vault:field reference="to__v" />
            <vault:field reference="capture_datetime__v" />
            <vault:field reference="shortened_engage_link__v" />
            <vault:field reference="sent_via__v" />
            <vault:field reference="product__v" />
            <vault:field reference="call__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="user__v" />
            <vault:field reference="clm_presentation__v" />
            <vault:field reference="key_message__v" />
            <vault:field reference="engage_link__v" />
            <vault:field reference="sent_from_platform__v" />
            <vault:field reference="detail_group__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Message Activity" name="message_activity__c">
        <vault:relatedObject relationship="message_activity__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="activity__v" width="200px" />
            <vault:field reference="activity_datetime__v" width="200px" />
            <vault:field reference="client_name__v" width="200px" />
            <vault:field reference="client_os__v" width="200px" />
            <vault:field reference="client_device__v" width="200px" />
            <vault:field reference="client_type__v" width="200px" />
            <vault:field reference="ip_address__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>