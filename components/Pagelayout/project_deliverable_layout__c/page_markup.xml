<vault:page xmlns:vault="VeevaVault" controller="Object.sp_project_deliverable__c">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="sp_description__c" required="true" />
            <vault:spacer />
            <vault:field reference="ownerid__v" />
            <vault:field reference="date_issued__c" required="true" />
            <vault:field reference="date_of_validation__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Deliverable Reviews" name="deliverable_reviews__c">
        <vault:relatedObject relationship="deliverable_reviews__cr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="comments__c" width="200px" />
            <vault:field reference="reviewer_name__c" width="200px" />
            <vault:field reference="date__c" width="200px" />
            <vault:field reference="version__c" width="200px" />
            <vault:field reference="accept_reject__c" width="200px" />
            <vault:field reference="explanation__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>