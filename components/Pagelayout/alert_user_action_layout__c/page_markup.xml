<vault:page xmlns:vault="VeevaVault" controller="Object.alert_user_action__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="alert__v" />
            <vault:field reference="user__v" required="true" />
            <vault:field reference="dismissed__v" />
            <vault:field reference="mobile_id__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>