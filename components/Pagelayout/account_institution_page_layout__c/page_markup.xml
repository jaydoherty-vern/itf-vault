<vault:page xmlns:vault="VeevaVault" controller="Objecttype.account__v.institution__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="hco_type_cda__v" />
            <vault:field reference="status_cda__v" />
            <vault:field reference="country_code__v" />
            <vault:field reference="primary_parent__v" readOnly="true" />
            <vault:field reference="account_identifier__v" />
            <vault:field reference="nhid_cda__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Contact Information" name="contact_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="office_phone_cda__v" />
            <vault:field reference="email_cda__v" />
            <vault:field reference="website_cda__v" />
            <vault:field reference="fax_cda__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Territory Field" name="territory_field_section__c" reference="territory_field_section__v" />
    <vault:section title="View User Territory" name="view_user_territory_section__c" reference="view_user_territory_section__v" />
    <vault:section title="X-Pages" name="myinsights_account_section__c" reference="myinsights_account_section__v">
        <vault:bind property="maxHeight" value="0" />
    </vault:section>
    <vault:section title="Members" name="members_section__c" reference="members_section__v" />
    <vault:section title="Member Of" name="member_of_section__c" reference="member_of_section__v" />
    <vault:section title="Addresses" name="addresses_section__c" reference="addresses_section__v" />
    <vault:section title="Calls (Account)" name="calls_account__c">
        <vault:relatedObject relationship="call2__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="address__v" width="200px" />
            <vault:field reference="call_channel__v" width="200px" />
            <vault:field reference="call_date__v" width="200px" />
            <vault:field reference="detailed_products__v" width="200px" />
            <vault:field reference="location__v" width="200px" />
            <vault:field reference="call2_status__v" width="200px" />
            <vault:field reference="territory__v" width="200px" />
            <vault:field reference="ownerid__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Medical Interactions" name="account_medx_section__c" reference="account_medx_section__v" />
    <vault:section title="Data Change Requests" name="data_change_requests__c">
        <vault:relatedObject relationship="data_change_requests__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="created_by__v" width="200px" />
            <vault:field reference="created_date__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="country_mapping__v" width="200px" />
            <vault:field reference="error__v" width="200px" />
            <vault:field reference="resolution_note__v" width="200px" />
            <vault:field reference="result__v" width="200px" />
            <vault:field reference="data_change_request_status__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="id" />
            <vault:field reference="veeva_network_id__v" />
            <vault:field reference="status__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="country__v" />
            <vault:field reference="vcountry__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>