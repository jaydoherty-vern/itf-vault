<vault:page xmlns:vault="VeevaVault" controller="Objecttype.assortment_line__v.im_assortment_section__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="assortment__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="collapse_by_default__v" />
            <vault:field reference="section_label__v" required="true" />
            <vault:field reference="sorting__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>