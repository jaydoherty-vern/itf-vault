<vault:page xmlns:vault="VeevaVault" controller="Objecttype.expense_line__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="expense_type__v" required="true" />
            <vault:field reference="event_budget__v" />
            <vault:field reference="description__v" />
            <vault:field reference="actual__v" />
            <vault:field reference="committed__v" />
            <vault:field reference="event__v" required="true" />
            <vault:field reference="expense_header__v" />
            <vault:field reference="split_amount_per_person__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Expense Attributions" name="expense_attributions__c">
        <vault:relatedObject relationship="expense_attributions__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="incurred_expense__v" width="200px" />
            <vault:field reference="actual__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>