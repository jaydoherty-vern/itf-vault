<vault:page xmlns:vault="VeevaVault" controller="Objecttype.medical_inquiry__v.medical_inquiry__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="medical_inquiry_status__v" readOnly="true" />
            <vault:field reference="fulfillment_status__v" readOnly="true" />
            <vault:field reference="ownerid__v" readOnly="true" />
            <vault:field reference="account__v" required="true" />
            <vault:field reference="call2__v" readOnly="true" />
            <vault:field reference="itf_irms_case_id__c" readOnly="true" />
            <vault:field reference="medinquiry_request_name__v" readOnly="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Disclaimer" name="details__c">
        <vault:detailform type="One-Column">
            <vault:control reference="disclaimer_field_control__v" name="disclaimer_field_control__c" label="Disclaimer" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attestation" name="attestation__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="itf_unsolicited_request__c" readOnly="true" />
            <vault:field reference="itf_proof_of_unsolicited_request__c" />
            <vault:field reference="itf_employee__c" readOnly="true" />
            <vault:field reference="itf_proof_of_itf_employee__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Delivery Requirements" name="delivery_requirements__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="delivery_method__v" required="true" />
            <vault:control reference="delivery_method_field_control__v" name="delivery_method_field_control__c">
                <vault:bind property="eom" value="false" />
                <vault:bind property="eoe" value="false" />
                <vault:bind property="eop" value="false" />
                <vault:bind property="eof" value="false" />
                <vault:bind property="ana" value="true" />
                <vault:bind property="ane" value="true" />
                <vault:bind property="anp" value="true" />
                <vault:bind property="anf" value="true" />
            </vault:control>
            <vault:field reference="assign_to_user__v" />
            <vault:field reference="itf_msl_follow_up__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Inquiry and Delivery Method Information" name="delivery_method_section__c" reference="delivery_method_section__v">
        <vault:bind property="mpi" value="true" />
        <vault:bind property="eom" value="false" />
        <vault:bind property="eoe" value="false" />
        <vault:bind property="eop" value="false" />
        <vault:bind property="eof" value="false" />
        <vault:bind property="ana" value="false" />
        <vault:bind property="ane" value="false" />
        <vault:bind property="anp" value="false" />
        <vault:bind property="anf" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Inquiry Information" name="inquiry_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="product__v" required="true" />
            <vault:field reference="inquiry_text__v" required="true" />
            <vault:control reference="multiple_product_inquiries_field_control__v" name="multiple_product_inquiries_field_control__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:control reference="medical_inquiry_save__v" name="medical_inquiry_save__c" />
        </vault:detailform>
    </vault:section>
</vault:page>