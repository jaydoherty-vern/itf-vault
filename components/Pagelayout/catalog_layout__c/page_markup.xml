<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_catalog__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="em_catalog_name__v" />
            <vault:field reference="product__c" />
            <vault:field reference="vspa_country_code__c" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="em_catalog_status__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="vault_link__v" />
            <vault:spacer />
            <vault:field reference="external_id__v" required="true" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Contract Lines" name="contract_lines__c">
        <vault:relatedObject relationship="contract_lines__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Contract Data Templates" name="contract_data_templates__c">
        <vault:relatedObject relationship="contract_data_templates__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Event Rules" name="event_rules1__c">
        <vault:relatedObject relationship="event_rules1__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Topic Materials (Topic)" name="topic_materials1__c">
        <vault:relatedObject relationship="topic_materials1__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Topics Using Material" name="topic_materials__c">
        <vault:relatedObject relationship="topic_materials__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>