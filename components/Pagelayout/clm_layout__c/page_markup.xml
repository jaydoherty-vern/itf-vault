<vault:page xmlns:vault="VeevaVault" controller="Objecttype.consent_type__v.clm__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="consent_header__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="channel_label__v" />
            <vault:field reference="channel_source__v" />
            <vault:field reference="default_consent_type__v" />
            <vault:field reference="product_preference__v" />
            <vault:field reference="consent_expires_in__v" />
            <vault:field reference="consent_custom_duration__v" />
            <vault:field reference="display_order__v" />
            <vault:control reference="consent_line__v" name="consent_line__c" />
            <vault:control reference="opt_out_consent_line__v" name="opt_out_consent_line__c" />
            <vault:field reference="opt_out_disclaimer_text__v" />
            <vault:control reference="signature_capture__v" name="signature_capture__c" />
            <vault:field reference="state__v" />
            <vault:field reference="zvod_consent_default_consent_text_file__v" />
            <vault:field reference="zvod_consent_activity_tracking__v" />
            <vault:field reference="unsubscribe_keyword__v" />
            <vault:field reference="subscribe_keyword__v" />
            <vault:field reference="legacy_consent_channel__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Consent Lines" name="consent_lines__c">
        <vault:relatedObject relationship="consent_type__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>