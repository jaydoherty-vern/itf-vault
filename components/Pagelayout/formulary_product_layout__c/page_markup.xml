<vault:page xmlns:vault="VeevaVault" controller="Object.formulary_products__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="competitor__v" />
            <vault:field reference="market__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="ownerid__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Benefit Design Lines" name="product__c">
        <vault:relatedObject relationship="product__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>