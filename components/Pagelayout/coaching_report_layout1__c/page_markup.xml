<vault:page xmlns:vault="VeevaVault" controller="Objecttype.coaching_report__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="manager__v" />
            <vault:field reference="employee__v" />
            <vault:field reference="review_date__v" />
            <vault:field reference="review_period__c" />
            <vault:field reference="coaching_report_status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Overall Ratings Summary" name="overall_ratings_summary__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="overall_rating__c" />
