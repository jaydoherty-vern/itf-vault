<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_speaker_nomination__v.renominate__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="speaker__v" required="true" />
            <vault:field reference="product__v" />
            <vault:field reference="type__v" />
            <vault:field reference="em_speaker_nomination_status__v" readOnly="true" />
            <vault:field reference="object_type__v" />
            <vault:field reference="account__v" readOnly="true" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Speaker Information" name="speaker_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="first_name__v" readOnly="true" />
            <vault:field reference="last_name__v" readOnly="true" />
            <vault:field reference="title__v" readOnly="true" />
            <vault:field reference="credentials__v" readOnly="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Justification" name="justification__c">
        <vault:detailform type="One-Column">
            <vault:field reference="justification__v" required="true" />
            <vault:field reference="comments__v" required="true" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>