<vault:page xmlns:vault="VeevaVault" controller="Object.benefit_design_line__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="benefit_design__v" />
            <vault:field reference="type__v" readOnly="true" />
            <vault:field reference="product__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Status and Restrictions" name="status_and_restrictions__c">
        <vault:detailform type="One-Column">
            <vault:field reference="benefit_design_line_status__v" />
            <vault:field reference="restrictions__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Notes" name="notes__c">
        <vault:detailform type="One-Column">
            <vault:field reference="notes__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Status and Restrictions (Source)" name="status_and_restrictions_source__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status_source__v" />
            <vault:field reference="restrictions_source__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Notes (Source)" name="notes_source__c">
        <vault:detailform type="One-Column">
            <vault:field reference="notes_source__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="external_id__v" readOnly="true" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="name__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>