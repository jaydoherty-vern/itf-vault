<vault:page xmlns:vault="VeevaVault" controller="Objecttype.vcountry__v.vcountry__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="country_name__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="alpha_2_code__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Speakers" name="speakers__c">
        <vault:relatedObject relationship="speakers__cr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>