<vault:page xmlns:vault="VeevaVault" controller="Objecttype.pricing_rule__v.delivery_discount_rule__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="product__v" required="true" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="pricing_group__v" />
            <vault:spacer />
            <vault:field reference="object_type__v" />
            <vault:field reference="order_campaign__v" />
            <vault:field reference="contract__v" />
            <vault:field reference="account__v" />
            <vault:field reference="price_book__v" />
            <vault:field reference="account_group__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Rule Definition" name="rule_definition__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="comparison_type__v" required="true" />
            <vault:field reference="quantity_min__v" required="true" />
            <vault:field reference="quantity_max__v" />
            <vault:field reference="discount_override__v" />
            <vault:field reference="discount_override_max__v" />
            <vault:field reference="rule_description__v" />
            <vault:field reference="suggestion_text__v" />
            <vault:field reference="suggestion_threshold__v" />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Preferred Delivery Conditions" name="preferred_delivery_conditions__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="preferred_delivery_start_date__v" />
            <vault:field reference="preferred_delivery_end_date__v" />
            <vault:field reference="include_all_preferred_deliveries__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>