<vault:page xmlns:vault="VeevaVault" controller="Object.inventory_order__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="order_create_date__v" />
            <vault:field reference="order_for_user__v" required="true" />
            <vault:field reference="order_status__v" />
            <vault:field reference="order_type__v" />
            <vault:field reference="order_submit_date__v" />
            <vault:field reference="total_order_fulfilled_quantity__v" />
            <vault:field reference="approved__v" />
            <vault:field reference="approved_date__v" />
            <vault:field reference="approved_by__v" />
            <vault:field reference="approver_user_id__v" />
            <vault:field reference="require_approval__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:spacer />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Inventory Order Lines" name="inventory_order_lines__c">
        <vault:relatedObject relationship="inventory_order_lines__vr" preventRecordCreate="false" modalCreateRecord="true" displayAsSimple="false">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>