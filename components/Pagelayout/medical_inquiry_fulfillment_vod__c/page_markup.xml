<vault:page xmlns:vault="VeevaVault" controller="Objecttype.call2__v.medical_inquiry_fulfillment__v">
    <vault:section title="Buttons" name="buttons__c">
        <vault:detailform type="One-Column">
            <vault:control reference="save__v" name="save__c" />
            <vault:control reference="savenew__v" name="savenew__c" />
            <vault:control reference="submit__v" name="submit__c" />
            <vault:control reference="more_actions__v" name="more_actions__c" />
            <vault:control reference="delete__v" name="delete__c" />
            <vault:field reference="controlling_parent_account__v" />
            <vault:field reference="parent_address__v" />
            <vault:field reference="allowed_products__v" />
            <vault:field reference="itf_call_outcome__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Professional Information" name="professional_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="account__v" required="true" />
            <vault:field reference="address__v" />
            <vault:field reference="license_expiration_date__v" />
            <vault:field reference="license_status__v" />
            <vault:field reference="assmca__v" />
            <vault:field reference="dea__v" />
            <vault:field reference="dea_expiration_date__v" />
            <vault:field reference="ship_dea__v" />
            <vault:field reference="ship_dea_expiration_date__v" />
            <vault:field reference="ship_assmca__v" />
            <vault:field reference="call2_status__v" readOnly="true" />
            <vault:field reference="call_type__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="call_channel__v" required="true" />
            <vault:field reference="call_date__v" />
            <vault:field reference="signature_date__v" readOnly="true" />
            <vault:field reference="license__v" />
            <vault:field reference="cds__v" />
            <vault:field reference="cds_expiration_date__v" />
            <vault:field reference="ship_cds__v" />
            <vault:field reference="ship_cds_expiration_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attendees" name="call_attendees_section__c" reference="call_attendees_section__v">
        <vault:bind property="paa" value="true" />
        <vault:bind property="ao" value="false" />
        <vault:bind property="atf" value="false" />
        <vault:bind property="st" value="false" />
        <vault:bind property="su" value="false" />
        <vault:bind property="ns" value="false" />
        <vault:bind property="fieldNames">
            <vault:list />
        </vault:bind>
    </vault:section>
    <vault:section title="Medical Inquiry Fulfillment" name="medical_inquiry_section__c" reference="medical_inquiry_section__v" />
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="One-Column">
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>