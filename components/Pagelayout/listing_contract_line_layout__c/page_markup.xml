<vault:page xmlns:vault="VeevaVault" controller="Objecttype.contract_line__v.base__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="contract__v" />
            <vault:field reference="local_currency__sys" />
            <vault:field reference="product__v" required="true" />
            <vault:field reference="mandatory_contract_line__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Contract Line Targets" name="contract_line_targets__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="im_facings_simple__v" />
            <vault:field reference="im_facings_horizontal__v" />
            <vault:field reference="im_facings_vertical__v" />
            <vault:field reference="im_moved_goods__v" />
            <vault:field reference="im_position__v" />
            <vault:field reference="im_inventory__v" />
            <vault:field reference="im_layer__v" />
            <vault:field reference="im_consumer_price__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
</vault:page>