    <vault:section title="Approval Rules Assigned to Model Field Force" name="approval_rules_assigned_to_model_ff__c">
        <vault:relatedObject relationship="aln_approval_rule__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="approval_rule_type__v" width="200px" />
            <vault:field reference="challenge_type__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Search Rules Assigned to Model Field Force" name="search_rules_assigned_to_model_ff__c">
        <vault:relatedObject relationship="aln_account_search_model_rules__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="status__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>