<vault:page xmlns:vault="VeevaVault" controller="Objecttype.monitored_text__v.flagged_text__v">
    <vault:section title="Flagged Text Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="object_type__v" />
            <vault:field reference="text_last_modified_date__v" />
            <vault:field reference="text_last_modified_by__v" />
            <vault:field reference="security_profile__v" />
            <vault:field reference="application_profile__v" />
            <vault:field reference="job_id__v" />
            <vault:field reference="monitored_date__v" />
            <vault:field reference="text__v" />
            <vault:field reference="vault_id_link__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Flagged Phrase(s)" name="flagged_phrases__c">
        <vault:relatedObject relationship="monitored_texts__vr" preventRecordCreate="true" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="flagged_phrase__v" width="200px" />
            <vault:field reference="state__v" width="200px" />
            <vault:field reference="category__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="ownerid__v" />
        </vault:detailform>
    </vault:section>
</vault:page>