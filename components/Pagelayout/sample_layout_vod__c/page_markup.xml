<vault:page xmlns:vault="VeevaVault" controller="Object.call2_sample__v">
    <vault:section title="Information" name="information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="account__v" required="true" />
            <vault:field reference="call2__v" />
            <vault:field reference="product__v" />
            <vault:field reference="delivery_status__v" />
            <vault:field reference="call_date__v" />
            <vault:field reference="quantity__v" />
            <vault:field reference="lot__v" required="true" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="system_information__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:spacer />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>