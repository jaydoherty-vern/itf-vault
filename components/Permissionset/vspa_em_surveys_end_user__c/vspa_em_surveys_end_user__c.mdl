RECREATE Permissionset vspa_em_surveys_end_user__c (
   label('VSPA_EM_Surveys_End_User'),
   active(true),
   description('Users can associate Surveys to specific Events in Events Management. This allows users to tailor a Survey to a specific Event in order to receive feedback about the Event’s usefulness, effectiveness, convenience, and so on.'),
   object.child_account__v.child_furigana__v.field_actions('read'),
   object.child_account__v.parent_child_furigana__v.field_actions('read'),
   object.child_account__v.parent_child_name__v.field_actions('read'),
   object.child_account__v.parent_furigana__v.field_actions('read'),
   object.survey_target__v.em_attendee__v.field_actions('edit',
      'read'),
   object.survey_target__v.em_event__v.field_actions('edit',
      'read'),
   object.survey_target__v.em_event_speaker__v.field_actions('edit',
      'read'),
   tab.my_accounts__v.tab_actions('view'),
   tab.my_schedule_tab__v.tab_actions('view')
);