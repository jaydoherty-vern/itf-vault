RECREATE Permissionset vspa_clear_sync_errors__c (
   label('VSPA_Clear_Sync_Errors'),
   active(true),
   description('This is a Permission Set to be used as a tool. 
Follow the instructions in this link and use the PS to substitute Step 2 ("Grant the user Edit FLS ..."):

