RECREATE Permissionset vspa_em_italy__c (
   label('VSPA_EM_Italy'),
   active(true),
   description('Permission set for the Italian VSPA package. The PS gives access to the IT-specific fields used in Events Management.'),
   object.em_event__v.child_event__c.object_actions('read'),
   object.em_event__v.congress__c.object_actions('read'),
   object.em_event__v.created_by__v.field_actions('read'),
   object.em_event__v.created_date__v.field_actions('read'),
   object.em_event__v.grants_donations__c.object_actions('read'),
   object.em_event__v.local_currency__sys.field_actions('read'),
   object.em_event__v.local_event__c.object_actions('read'),
   object.em_event__v.modified_by__v.field_actions('read'),
   object.em_event__v.modified_date__v.field_actions('read'),
   object.em_event__v.other_activity__c.object_actions('read'),
   object.em_event__v.ownerid__v.field_actions('read'),
   object.em_event__v.parent_event__c.object_actions('read'),
   object.em_event__v.small_meeting__c.object_actions('read'),
   object.em_event__v.sponsorship__c.object_actions('read'),
   object.em_event__v.third_party_event__c.object_actions('read'),
   object.em_event__v.vspa_cme_event__c.field_actions('edit',
      'read'),
   object.em_event__v.vspa_sponsor_type__c.field_actions('edit',
      'read'),
   tab.my_accounts__v.tab_actions('view'),
   tab.my_schedule_tab__v.tab_actions('view')
);