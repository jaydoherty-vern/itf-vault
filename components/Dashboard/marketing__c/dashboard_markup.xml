    <vault:format showlegend="true" showvalue="true" xaxislabel="Email Template" yaxislabel="Record Count (Email Activity)" />
    <vault:series metric="RecordCount">
      <vault:grouping key="email_activity__v___sent_email__v.approved_email_template__v" value="" />
