Field longitude_vod__c (
   label('Longitude'),
   type('Number'),
   active(true),
   description('Longitude of this address. Used for mapping. This value is set to blank via trigger whenever a relevant address field changes. If zero, the longitude is written from the "MyMaps" functionality when the user maps this address. This field can be pre populated from an external program.'),
   required(false),
   unique(false),
   max_value(999999999.999999),
   min_value(-999999999.999999),
   scale(6),
   help_content(),
   list_column(false),
   order(28),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   rollup(false),
   control_binding()
);