Field initial_risk_rating__c (
   label('Initial Risk Rating'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(28),
   formula('If(impact__c*likelihood__c>=15,"Severe",If(impact__c*likelihood__c>=10,"High",If(impact__c*likelihood__c>=4,"Medium","Low")))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);