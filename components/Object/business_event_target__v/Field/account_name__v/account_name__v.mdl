Field account_name__v (
   label('Account Name'),
   type('String'),
   active(true),
   description('Account Name based upon the Account_vod reference field'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(17),
   formula('If(account__vr.ispersonaccount__v,
    If(account__vr.object_type__vr.name__v=''Business_Professional_vod'',
        account__vr.last_name_cda__v & ", " & account__vr.first_name_cda__v & " (" & account__vr.primary_parent__vr.name__v & ")",
        account__vr.last_name_cda__v & If(Length(account__vr.first_name_cda__v)=0, "", ", " & account__vr.first_name_cda__v) & If(Length(account__vr.middle_name_cda__v)=0, "", ", " & account__vr.middle_name_cda__v) & If(IsBlank(account__vr.suffix_cda__v), "", " " & account__vr.suffix_cda__v)
    ),
    If(Id(account__vr.primary_parent__v)!='''',
        account__vr.name__v & " - " & account__vr.primary_parent__vr.name__v,
        account__vr.name__v
    )
)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);