Field product_qs__c (
   label('Product'),
   type('Object'),
   active(true),
   description('Lookup to the Product Catalog (filters = detail & detail groups & detail topics only)'),
   required(false),
   unique(false),
   help_content(),
   list_column(false),
   create_object_inline(false),
   order(34),
   object('product__v'),
   relationship_type('reference'),
   relationship_outbound_name('product_qs__cr'),
   relationship_inbound_name('account_tactics__cr'),
   relationship_inbound_label('Account Tactics'),
   relationship_deletion('setnull'),
   relationship_criteria([product_type__v CONTAINS ('detail_group__v', 'detail_topic__v', 'detail__v')]),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);