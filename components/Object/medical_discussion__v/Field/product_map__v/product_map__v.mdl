Field product_map__v (
   label('Product Map'),
   type('Picklist'),
   active(true),
   description('Special field used to create dependent picklists on Medical Discussions based on product. The values for this field are the textual names of Product Details and Topics. This field should not be placed on any of the Medical Discussion page layouts.'),
   required(false),
   unique(false),
   help_content('Field to create dependency relationships on medical discussion fields based on product. The picklist values for this field are the textual names of detailed products. The values must be an exact match. This field should not be placed on any layouts.'),
   list_column(false),
   order(35),
   multi_value(false),
   picklist('Picklist.medical_discussion_product_map__v'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   editable(true),
   control_binding()
);