Field global_rule__v (
   label('Global Rule'),
   type('Boolean'),
   active(true),
   description('Used by EM Business Rules to define whether the rule applies to Event Types across all countries. If this field is marked "true", the rule will apply to any country the triggering event is associated with. If "false", the rule will apply to the Country defined in the applicable Rule Configuration record.'),
   required(false),
   checkbox(true),
   help_content('Restrict this rule to apply for events across all countries. This value cannot be edited after the rule is saved. See documentation for details.'),
   list_column(false),
   order(21),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);