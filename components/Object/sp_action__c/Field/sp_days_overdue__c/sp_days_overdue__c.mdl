Field sp_days_overdue__c (
   label('Days Overdue'),
   type('String'),
   active(true),
   description('PMO:: Number of Days the Action is still open after the scheduled Target Date'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(23),
   formula('If(Today("user")>sp_target_date__c,If(Text(sp_status__c)=''Open'',Text(Today("user")-sp_target_date__c),''''),'''')'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);