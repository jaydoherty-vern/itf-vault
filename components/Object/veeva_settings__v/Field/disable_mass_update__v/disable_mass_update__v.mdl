Field disable_mass_update__v (
   label('DISABLE_MASS_UPDATE'),
   type('Boolean'),
   active(true),
   description('Configurable parameter to prevent display of Mass Update button on My Accounts.
	
	"false" = (Default) Display Mass Update button.
	"true" = Do not display Mass Update button.
	
