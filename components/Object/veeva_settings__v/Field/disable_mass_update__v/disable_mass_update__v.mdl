   required(false),
   checkbox(true),
   help_content(),
   list_column(false),
   order(93),
   default_value('true'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);