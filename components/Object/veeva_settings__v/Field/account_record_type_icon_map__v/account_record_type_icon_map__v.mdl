Field account_record_type_icon_map__v (
   label('ACCOUNT_RECORD_TYPE_ICON_MAP'),
   type('String'),
   active(true),
   description('The value of this setting is a delimited string of the format: 
<ICON_NAME>:<CUSTOM_RECORD_TYPE>,<CUSTOM_RECORD_TYPE>;<ICON_NAME>:<CUSTOM_RECORD_TYPE>,<CUSTOM_RECORD_TYPE> 

ICON_NAME is one of the standard icons we deliver (see attached ppx) and CUSTOM_RECORD_TYPE is the name of the custom record type that is mapped to the icon. Multiple custom record types can be tied to the same icon by placing them in a comma delimited list. 

Multiple icon mappings are separated by a semicolon. 

Example: 

Professional_vod:MyCustom1,MyCustom2;Hospital_vod:MyCustom3'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(13),
   default_value('"ACCOUNT_RECORD_TYPE_ICON_MAP;;Common"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);