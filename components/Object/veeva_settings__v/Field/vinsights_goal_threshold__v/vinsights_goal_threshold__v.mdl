Field vinsights_goal_threshold__v (
   label('VInsights Goal Threshold'),
   type('String'),
   active(true),
   description('Defines thresholds for the color of the Goal Attainment. If attainment is less than the first number, the attainment percentage will be displayed in Red. If between the first and second number, the attainment percentage will be displayed in yellow. Otherwise, will be displayed in Green.'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(309),
   default_value('''10,25'''),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);