Field disable_rm_query__v (
   label('DISABLE_RM_QUERY'),
   type('Boolean'),
   active(true),
   description('Configurable parameter to prevent a view from executing for a territory with too many levels.
	
	"false" = (Default) Runs as normal.
	"true" = Only runs view for a territory that is at most one level deep.'),
   required(false),
   checkbox(true),
   help_content(),
   list_column(false),
   order(98),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);