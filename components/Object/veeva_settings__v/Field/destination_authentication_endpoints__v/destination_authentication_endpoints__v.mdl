Field destination_authentication_endpoints__v (
   label('DESTINATION AUTHENTICATION ENDPOINTS'),
   type('String'),
   active(true),
   description('References a Veeva message that contains the list of destination endpoints used for Delegated Authentication to log in to other orgs. List of destination endpoints used for Delegated Authentication to log in to other orgs. Syntax is <ENDPOINT NAME>,<AUTH URL>,<APPLIES TO URL>;;'),
   required(false),
   unique(false),
   max_length(255),
   help_content('The ENDPOINT NAME is displayed to end users and cannot include commas or semicolons.'),
   list_column(false),
   order(84),
   default_value('"DESTINATION_AUTHENTICATION_ENDPOINTS;;Common"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);