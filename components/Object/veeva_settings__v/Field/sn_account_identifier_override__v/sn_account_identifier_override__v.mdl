Field sn_account_identifier_override__v (
   label('SN Account Identifier Override'),
   type('String'),
   active(true),
   description('This setting defines which Account fields to display as secondary identifiers on account cards in Stakeholder Navigator. Populate this setting with the API name of the fields on the Account object. Up to two fields can be defined for this setting, separated by semicolons.'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(330),
   default_value('"account_identifier__v"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);