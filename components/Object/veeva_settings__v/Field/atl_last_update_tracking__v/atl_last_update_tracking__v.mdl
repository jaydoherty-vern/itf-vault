Field atl_last_update_tracking__v (
   label('ATL_LAST_UPDATE_TRACKING'),
   type('Boolean'),
   active(true),
   description('Flag that enables tracking of changes to Account Shares  generated by Account Territory Loader tool. This is to allow territory changes on mobile platforms to be properly synchronized. When enabled, a special field on Account, ATL_Last_Update_Date_Time_vod__c, will be updated on all Accounts affected by the ATL process.'),
   required(false),
   checkbox(true),
   help_content('Account Territory Loader activity tracking for mobile synchronization.'),
   list_column(false),
   order(22),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);