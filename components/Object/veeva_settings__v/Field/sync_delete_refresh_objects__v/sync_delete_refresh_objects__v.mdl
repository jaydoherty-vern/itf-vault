Field sync_delete_refresh_objects__v (
   label('SYNC_DELETE_REFRESH_OBJECTS_vod'),
   type('String'),
   active(true),
   description('If SYNC_DELETE_REFRESH_MODE_vod is PRODUCTION or TEST, then this setting establishes which tables to use the special delete refresh mode. This value can be "ALL" or the name and category of a Message, separated by 2 semicolons, e.g. "SYNC_REFRESH_TABLES;;TABLET". The message itself should contain a comma-separated list of tables. Any value other than ALL or a valid Message reference will be treated as NONE.'),
   required(false),
   unique(false),
   max_length(255),
   help_content('ALL, NONE,  or a Message reference in the format MESSAGE_NAME;;CATEGORY.'),
   list_column(false),
   order(274),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);