Field paperdetail__v (
   label('PaperDetail'),
   type('String'),
   active(true),
   description('The value of this message will display in parenthesis next to a Detail record on the Call Report.  Designed to be used if leveraging an integration with an eDetailing solution to provide differentiation between electronic and paper details.'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(248),
   default_value('"PaperDetail;;CallReport"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);