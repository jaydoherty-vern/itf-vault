Field detail_group__v (
   label('Detail Group'),
   type('Object'),
   active(true),
   description('Detail_Group_vod represents the Detail Group to which this MultiChannel_Consent_vod record is associated. This will correspond to the Detail Group to which the product (Product_vod) is aligned. If the Product_vod entity is not related to a Detail Group, then this will be NULL. This will also be NULL in the case of an Opt-In consent record.'),
   required(false),
   unique(false),
   help_content(),
   list_column(false),
   create_object_inline(false),
   order(42),
   object('product__v'),
   relationship_type('reference'),
   relationship_outbound_name('detail_group__vr'),
   relationship_inbound_name('multichannel_consents__vr'),
   relationship_inbound_label('Multichannel Consents'),
   relationship_deletion('block'),
   relationship_criteria([product_type__v = 'detail_group__v']),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);