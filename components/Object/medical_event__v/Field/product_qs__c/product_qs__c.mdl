Field product_qs__c (
   label('Product'),
   type('Object'),
   active(true),
   description('Lookup to the Product Catalog object. Products part of the Medical Events must be in the Product Catalog, stored as Details.'),
   required(false),
   unique(false),
   help_content(),
   list_column(false),
   create_object_inline(false),
   order(83),
   object('product__v'),
   relationship_type('reference'),
   relationship_outbound_name('product_qs__cr'),
   relationship_inbound_name('medical_events__cr'),
   relationship_inbound_label('Medical Events'),
   relationship_deletion('setnull'),
   relationship_criteria([product_type__v = 'detail__v']),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);