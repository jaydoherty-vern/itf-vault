Field field__v (
   label('Field Name'),
   type('String'),
   active(true),
   description('Field name for Custom Field and Picklist Value record types. (Note the field name of custom fields does not include the __c in the Translation Workbench export. This is the value actually entered in the UI when the field was created.)'),
   required(false),
   unique(false),
   max_length(40),
   help_content('Field name for Custom Field and Picklist Value types - do not include __c.'),
   list_column(false),
   order(12),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);