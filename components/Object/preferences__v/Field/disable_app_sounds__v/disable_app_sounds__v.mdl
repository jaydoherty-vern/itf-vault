Field disable_app_sounds__v (
   label('Disable App Sounds'),
   type('Boolean'),
   active(true),
   description('Stores the end user''s sound toggle state preference. When False, the Veeva CRM app sounds play. When True, the app sounds are muted.'),
   required(false),
   checkbox(true),
   help_content('Control audible in-app sounds. This setting does not impact media sounds.'),
   list_column(false),
   order(29),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);