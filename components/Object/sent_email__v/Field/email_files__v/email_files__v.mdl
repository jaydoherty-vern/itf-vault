Field email_files__v (
   label('Email Files'),
   type('LongText'),
   active(true),
   description('Captures the IDs of Salesforce Files (ContentDocument records) that were included in the email payload. This will be a comma separated list of SFDC IDs.'),
   required(false),
   max_length(32000),
   help_content(),
   list_column(false),
   order(78),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);