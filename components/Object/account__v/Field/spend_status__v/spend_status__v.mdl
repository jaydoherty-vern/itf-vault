Field spend_status__v (
   label('Spend Status'),
   type('String'),
   active(true),
   description('Displays red, yellow, or green image based on Spend_Status_Value_vod__c.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(132),
   formula('Case(If(spend_amount__c = "Below Monitoring Threshold", "Below_Threshold__v", If(spend_amount__c = "Monitor Spend", "Monitor__v", If(spend_amount__c = "Cease Spend", "Cease__v", "Invalid__v"))), "Below_Threshold_vod", icon("circle", "#035612", "Below Monitoring Threshold"), "Monitor__v", icon("exclamation-triangle", "#FFA500","Monitor Spend"), "Cease__v", icon("square", "#FF0000", "Cease Spend"), icon("circle", "#035612", "Below Monitoring Threshold"))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   show_as_icon(true),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);