Field column_labels_included__v (
   label('Column Labels Included'),
   type('Boolean'),
   active(true),
   description('Column labels included defines if the file that will be loaded includes the column headers.  If checked, the first row of data will not be loaded as part of the processing.'),
   required(false),
   checkbox(true),
   help_content('If the file will have the column lables as the first line for this template, then check this box.'),
   list_column(false),
   order(13),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);