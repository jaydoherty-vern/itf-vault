Field business_benefit_value__c (
   label('Business Benefit Value'),
   type('Number'),
   active(true),
   description('Value is calculated by the selection of the Business Benefit field.'),
   required(false),
   unique(false),
   max_value(999999999),
   min_value(-999999999),
   scale(0),
   help_content('Value is calculated by the selection of the Business Benefit field:
High = 3
Medium = 2
Low = 1'),
   list_column(false),
   order(152),
   formula('Case(
business_benefit__c ,
"HIGH" , 3,
"MEDIUM", 2,
"Low", 1,
0
)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   rollup(false),
   control_binding()
);