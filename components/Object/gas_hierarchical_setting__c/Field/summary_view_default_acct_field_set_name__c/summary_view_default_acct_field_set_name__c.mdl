Field summary_view_default_acct_field_set_name__c (
   label('Summary View Default Acct Field Set Name'),
   type('String'),
   active(true),
   description('Name of the Account field set to be used to display Account fields summary by default. If one exists for the specific Recordtype (follows @@RectypeName@@FieldSetName naming convention for the FieldSet name), then that field set will be used'),
