Field sample_status__v (
   label('Sample Status'),
   type('String'),
   active(true),
   description('Sample Status defines the status of the State License and controls the Sample Status.  Sample Status of Valid represents a Green indicator.  Sample Status of Pending represents a Yellow Indicator.  Sample Status of Invalid represents a Red Indicator.
ORIGINAL:IF(LEN( TRIM(License_vod__c )) < 1,"Invalid",IF(ISNULL( License_Expiration_Date_vod__c ),"Invalid",IF(AND( License_Expiration_Date_vod__c >= TODAY() ,ISPICKVAL(License_Status_vod__c, "Valid_vod")),"Valid",IF(AND( License_Expiration_Date_vod__c >= TODAY() ,ISPICKVAL(License_Status_vod__c, "New_vod")), "Pending","Invalid"))))'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(82),
   formula('"Valid"'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);