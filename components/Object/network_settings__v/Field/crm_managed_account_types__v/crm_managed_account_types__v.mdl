Field crm_managed_account_types__v (
   label('CRM Managed Account Types'),
   type('String'),
   active(true),
   description('This setting points to the name of the Veeva Message used to configure what Account record types and child entities should be managed locally in CRM. Please see documentation for more details.'),
   required(false),
   unique(false),
   max_length(80),
   help_content('All Account Record Types included in this setting are managed locally in CRM'),
   list_column(false),
   order(13),
   default_value('"CRM_MANAGED_ACCOUNT_TYPES;;NETWORK"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);