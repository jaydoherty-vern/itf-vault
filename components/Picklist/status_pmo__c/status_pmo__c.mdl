   Picklistentry(@Picklistentry/build__c.mdl),
   Picklistentry(@Picklistentry/build_complete__c.mdl),
   Picklistentry(@Picklistentry/testing_completed__c.mdl),
   Picklistentry(@Picklistentry/deployed__c.mdl),
   Picklistentry(@Picklistentry/closed__c.mdl),
   Picklistentry(@Picklistentry/cancelled__c.mdl),
   Picklistentry(@Picklistentry/deferred__c.mdl),
   Picklistentry(@Picklistentry/lockdown__c.mdl),
