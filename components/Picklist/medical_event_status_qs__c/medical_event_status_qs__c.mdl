RECREATE Picklist medical_event_status_qs__c (
   label('Status'),
   active(true),
   Picklistentry(@Picklistentry/approved__c.mdl),
   Picklistentry(@Picklistentry/cancelled__c.mdl),
   Picklistentry(@Picklistentry/completed__c.mdl),
   Picklistentry(@Picklistentry/planned__c.mdl),
   Picklistentry(@Picklistentry/rejected__c.mdl),
   Picklistentry(@Picklistentry/submitted_for_review__c.mdl),
   Picklistentry(@Picklistentry/pending_regulatory_approval__c.mdl),
   Picklistentry(@Picklistentry/pending_sponsor_approval__c.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);