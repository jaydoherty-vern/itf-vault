   label('Status'),
   active(true),
   Picklistentry(@Picklistentry/saved__c.mdl),
   Picklistentry(@Picklistentry/approved__c.mdl),
   Picklistentry(@Picklistentry/rejected__c.mdl),
   Picklistentry(@Picklistentry/pending_approval__c.mdl),
   Picklistentry(@Picklistentry/paid__c.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);