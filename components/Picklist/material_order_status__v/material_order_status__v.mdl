RECREATE Picklist material_order_status__v (
   label('Material Order Status'),
   active(true),
   Picklistentry(@Picklistentry/approved__c.mdl),
   Picklistentry(@Picklistentry/on_hold__c.mdl),
   Picklistentry(@Picklistentry/pending__c.mdl),
   Picklistentry(@Picklistentry/in_progress__c.mdl),
   Picklistentry(@Picklistentry/rejected__c.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);