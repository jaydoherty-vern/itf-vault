RECREATE Picklist design_status__c (
   label('Design Status'),
   active(true),
   Picklistentry(@Picklistentry/met__c.mdl),
   Picklistentry(@Picklistentry/not_met__c.mdl),
   Picklistentry(@Picklistentry/partially_met__c.mdl),
   Picklistentry(@Picklistentry/initial_design__c.mdl),
   Picklistentry(@Picklistentry/detail_design__c.mdl),
   Picklistentry(@Picklistentry/final_design__c.mdl),
   Picklistentry(@Picklistentry/design_documentation_completed__c.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);