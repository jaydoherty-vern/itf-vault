RECREATE Picklist call_outcome__c (
   label('Call Outcome'),
   active(true),
   Picklistentry(@Picklistentry/patients_identified_ready_to_prescribe__c.mdl),
   Picklistentry(@Picklistentry/agrees_to_use_duvyzat__c.mdl),
   Picklistentry(@Picklistentry/need_to_identify_patients__c.mdl),
   Picklistentry(@Picklistentry/not_clinically_convinced__c.mdl),
   Picklistentry(@Picklistentry/not_willing_to_prescribe__c.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);