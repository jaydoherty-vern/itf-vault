<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="task">
    <vwf:label>Confirm Adherence Enrollment</vwf:label>
    <vwf:hideHomePageLink>false</vwf:hideHomePageLink>
    <vwf:controls>
      <vwf:control name="call_the_patient_to_inform_them_of_adher__c" label="Call the Patient to inform them of adherence calls associated with the patient program.&#xD;&#xA;&#xD;&#xA;Does the Patient Wish to receive adherence Check-In calls?" type="instructions">
        <vwf:instructions>Call the Patient to inform them of adherence calls associated with the patient program.&#xD;
&#xD;
Does the Patient Wish to receive adherence Check-In calls?</vwf:instructions>
      </vwf:control>
      <vwf:control name="verdict_public_key__c" type="verdict">
        <vwf:verdict label="Yes" name="verdict_yes__c" />
        <vwf:verdict label="No" name="verdict_no__c" />
      </vwf:control>
      <vwf:control name="task_creation_date__v" label="label" type="date">
        <vwf:datefield type="date" />
        <vwf:offset>
          <vwf:amount>7</vwf:amount>
          <vwf:unit>days</vwf:unit>
        </vwf:offset>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
  <vwf:assignment participant="part_patient_support_specialist__c" excludeowner="false" />
  <vwf:assignmentType type="every" />
  <vwf:notifications />
  <vwf:reminders />
  <vwf:completeWithoutViewing value="false" />
  <vwf:taskRequirement requirement="required" />
</vwf:stepdetails>