   document_content_lifecycle(),
   record_content_lifecycle(),
   description('A basic speaker nomination approval process with manual approver selection, including auto-approval for administrator users.'),
   auto_start(false),
   envelope_name_format(),
   cancellation_comment(false),
   workflow_variables(),
   workflow_content_type('Object'),
   class(),
   cardinality('One'),
   show_fields(),
   bound_create_draft(),
   users_can_only_complete_one_task(false),
   roles_cannot_complete_task(),
   disallowed_workflow_owner_actions(),
   disallowed_non_task_owner_actions(),
   disallowed_actions(),
   Objectworkflowstep(@Objectworkflowstep/approve_or_reject__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/auto_approve__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/end__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/manual_approver_review__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/notification_approved__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/notification_rejected__c.mdl),
