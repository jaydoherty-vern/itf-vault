   workflow_content_type('Object'),
   class(),
   cardinality('OneOrMany'),
   show_fields(),
   bound_create_draft(),
   users_can_only_complete_one_task(false),
   roles_cannot_complete_task(),
   disallowed_workflow_owner_actions(),
   disallowed_non_task_owner_actions(),
   disallowed_actions(),
   Objectworkflowstep(@Objectworkflowstep/assign__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/end__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/start__c.mdl)
);