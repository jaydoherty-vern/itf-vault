RECREATE Objectworkflow assign_call__c (
   label('Assign Call'),
   active(false),
   object_lifecycles('Objectlifecycle.envelope_lifecycle__sys'),
   document_content_lifecycle(),
   record_content_lifecycle('Objectlifecycle.call_lifecycle__v'),
