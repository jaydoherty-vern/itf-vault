<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="task">
    <vwf:label>Verify Patient's Coverage</vwf:label>
    <vwf:hideHomePageLink>false</vwf:hideHomePageLink>
    <vwf:controls>
      <vwf:control name="please_contact_the_insurance_company_and__c" label="Please contact the insurance company and collect the coverage details." type="instructions">
        <vwf:instructions>Please contact the insurance company and collect the coverage details.</vwf:instructions>
      </vwf:control>
      <vwf:control name="verdict_public_key__c" type="verdict">
        <vwf:verdict label="Prior Authorization Required" name="verdict_prior_authorization_required__c" />
        <vwf:verdict label="Prior Authorization Not Required" name="verdict_prior_authorization_not_required__c" />
      </vwf:control>
      <vwf:control name="workflow_creation_date__v" label="label" type="date">
        <vwf:datefield type="date" />
        <vwf:offset>
          <vwf:amount>7</vwf:amount>
          <vwf:unit>days</vwf:unit>
        </vwf:offset>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
  <vwf:assignment participant="part_benefits_specialist__c" excludeowner="false" />
  <vwf:assignmentType type="every" />
  <vwf:updateSharingSettingsRules>
    <vwf:rule event="taskAssignment" operator="add">
      <vwf:roles>
        <vwf:role>Objectlifecyclerole.benefits_specialist__v</vwf:role>
      </vwf:roles>
    </vwf:rule>
  </vwf:updateSharingSettingsRules>
  <vwf:notifications />
  <vwf:reminders />
  <vwf:completeWithoutViewing value="false" />
  <vwf:taskRequirement requirement="required" />
</vwf:stepdetails>