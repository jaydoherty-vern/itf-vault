<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="task">
    <vwf:label>Confirm Fulfillment Request</vwf:label>
    <vwf:hideHomePageLink>false</vwf:hideHomePageLink>
    <vwf:controls>
      <vwf:control name="please_confirm_the_fulfillment_request_h__c" label="Please confirm the fulfillment request has been sent to the Specialty Pharmacy." type="instructions">
        <vwf:instructions>Please confirm the fulfillment request has been sent to the Specialty Pharmacy.</vwf:instructions>
      </vwf:control>
      <vwf:control name="workflow_creation_date__v" label="label" type="date">
        <vwf:datefield type="date" />
        <vwf:offset>
          <vwf:amount>7</vwf:amount>
          <vwf:unit>days</vwf:unit>
        </vwf:offset>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
  <vwf:assignment participant="part_patient_support_specialist__c" excludeowner="false" />
  <vwf:assignmentType type="every" />
  <vwf:notifications />
  <vwf:reminders />
  <vwf:completeWithoutViewing value="false" />
  <vwf:taskRequirement requirement="required" />
</vwf:stepdetails>