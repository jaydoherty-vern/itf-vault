RECREATE Objectworkflow fulfillment_workflow__c (
   label('Fulfillment Workflow'),
   active(true),
   object_lifecycles('Objectlifecycle.fulfillment_lifecycle__v'),
   document_content_lifecycle(),
   record_content_lifecycle(),
   description(),
   auto_start(false),
   envelope_name_format(),
   cancellation_comment(false),
   workflow_variables(),
   workflow_content_type('Object'),
   class(),
   cardinality('One'),
   show_fields(),
   bound_create_draft(),
   users_can_only_complete_one_task(false),
   roles_cannot_complete_task(),
   disallowed_workflow_owner_actions(),
   disallowed_non_task_owner_actions(),
   disallowed_actions(),
   Objectworkflowstep(@Objectworkflowstep/cs_delivered__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/cs_pending_shipment_confirmation__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/cs_pending_triage__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/cs_shipment_confirmed__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/decision_confirm_delivery__c.mdl),
   Objectworkflowstep(@Objectworkflowstep/end__c.mdl),
