RECREATE Objectvalidation v2ok_data_change_request__c.firstname_mandatory_insert__c (
   label('FirstName_Mandatory_Insert'),
   active(false),
   expression('Not(And(Text(change_type__c)="Create",IsBlank(first_name__c),object_type__vr.name__v="Professional"))'),
   description('First Name is Mandatory for Insert. Update or Delete calculated if missing.'),
   error_message('Mandatory for "Create" data change request type.'),
   error_location('first_name__c')
);